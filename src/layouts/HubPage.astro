---
import '../styles/global.css';
import VariantHub from '@/components/VariantHub.astro';
import PocketHub from '@/components/PocketHub.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SharePage from '@/components/SharePage.astro';
interface Props {
  variant?: 'flow' | 'pocket' | 'journal' | 'focus';
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  publishedTime?: string;
  image?: string;
  imageAlt?: string;
}
const {
  variant = 'pocket',
  title = 'Islam with Ayoub | Quran readings & resources',
  path = '',
  noindex = false,
} = Astro.props;

const siteUrl = new URL(
  import.meta.env.SITE ?? 'https://islam.ayoubabed.xyz/'
).toString();
const socialImageUrl = new URL(
  Astro.props.image ?? 'islam-with-ayoub-share.png',
  siteUrl
).toString();
const socialImageAlt =
  Astro.props.imageAlt ??
  'Islam with Ayoub. Quran readings, articles and resources, beside a teal clothbound book.';
const isArticle = Boolean(Astro.props.publishedTime);
const basePath = import.meta.env.BASE_URL;
const canonicalUrl = new URL(path, siteUrl).toString();
const pageDescription =
  Astro.props.description ??
  "Read The Clear Quran online, request free English Quran copies where eligible, find Ayoub's stream edition, and watch recorded sessions and learning resources.";

const structuredData = {
  '@context': 'https://schema.org',
  '@type': isArticle ? 'Article' : 'WebPage',
  name: title,
  url: canonicalUrl,
  description: pageDescription,
  image: socialImageUrl,
  ...(isArticle
    ? {
        headline: title,
        datePublished: Astro.props.publishedTime,
        mainEntityOfPage: canonicalUrl,
        publisher: {
          '@type': 'Person',
          name: 'Ayoub Abedrabbo',
          url: 'https://ayoubabed.xyz/',
        },
      }
    : {}),
  author: {
    '@type': 'Person',
    name: 'Ayoub Abedrabbo',
  },
  sameAs: [
    'https://www.tiktok.com/@ayoubabedrabbo',
    'https://www.twitch.tv/ayoubabedrabbo',
    'https://www.youtube.com/channel/UCQ5YfTwU5n_khZx-WJEkZKQ',
    'https://ko-fi.com/ayoubab1',
  ],
};
---

<html lang="en">
  <head>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const dark = saved === 'dark';
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      } catch {
        /* The default palette remains usable without storage. */
      }
    </script>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href={`${basePath}favicon.ico`}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href={`${basePath}favicon.svg`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${basePath}apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${basePath}site.webmanifest`} />
    <meta name="theme-color" content="#335966" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteUrl}sitemap.xml`} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content="Islam with Ayoub" />
    <meta property="og:locale" content="en_US" />
    {isArticle && (
      <meta
        property="article:published_time"
        content={Astro.props.publishedTime}
      />
    )}
    {isArticle && (
      <meta property="article:author" content="https://ayoubabed.xyz/" />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {!Astro.props.image && (
      <meta property="og:image:type" content="image/png" />
    )}
    {!Astro.props.image && <meta property="og:image:width" content="1733" />}
    {!Astro.props.image && <meta property="og:image:height" content="907" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
  </head>
  <body>
    <div data-site-shell class="site-shell">
      <a href="#main-content" class="skip-link">
        Skip to content
      </a>
      <SiteHeader />
      <div id="main-content" tabindex="-1" class="site-main">
        {Astro.slots.has('default') ? (
          <slot />
        ) : variant === 'pocket' ? (
          <PocketHub />
        ) : (
          <VariantHub variant={variant} />
        )}
      </div>
      {!noindex && (
        <SharePage
          title={title}
          description={pageDescription}
          url={canonicalUrl}
        />
      )}
      <SiteFooter />
    </div>
  </body>
</html>
