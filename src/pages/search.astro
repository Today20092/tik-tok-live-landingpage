---
import HubPage from '@/layouts/HubPage.astro';
import Section from '@/components/lumos/Section.astro';
import Heading from '@/components/lumos/Heading.astro';
import SearchInput from '@/components/SearchInput';
const base = import.meta.env.BASE_URL;
---

<HubPage
  title="Search Quran resources | Islam with Ayoub"
  description="Search Ayoub's Quran articles, reading notes, live session resources, and learning links to find a useful place to begin."
  path="search/"
  noindex
>
  <Section tag="main" class="page-section" paddingTop="medium" paddingBottom="small" gap="0">
    <div>
      <header class="u-pb-7">
        <Heading tag="h1" class="page-title">Search the site</Heading>
        <p class="search_p">
          Find words and phrases in articles and reading resources.
        </p>
      </header>
      {import.meta.env.DEV ? (
        <p class="search_p-2">
          Search uses the published index. Run <code>pnpm build</code>, then{' '}
          <code>pnpm preview</code> to try it.
        </p>
      ) : (
        <>
          <link
            rel="stylesheet"
            href={`${base}pagefind/pagefind-component-ui.css`}
          />
          <script
            is:inline
            type="module"
            src={`${base}pagefind/pagefind-component-ui.js`}
          ></script>
          <div
            id="search"
            class="search_search"
            aria-label="Site search"
          >
            <pagefind-config
              bundle-path={`${base}pagefind/`}
              base-url={base}
            ></pagefind-config>
            <SearchInput client:load />
            <pagefind-filter-dropdown
              filter="Type"
              label="Content type"
            ></pagefind-filter-dropdown>
            <pagefind-summary></pagefind-summary>
            <pagefind-results></pagefind-results>
          </div>
          <p
            id="search-status"
            role="status"
            class="search_search-status"
          >
            Loading search…
          </p>
          <noscript>
            <p class="search_p-3">
              Enable JavaScript to search, or browse{' '}
              <a href={`${base}articles/`} class="u-underline">
                all articles
              </a>
              .
            </p>
          </noscript>
          <script is:inline>
            window.addEventListener('DOMContentLoaded', () => {
              const status = document.getElementById('search-status');
              if (!window.PagefindComponents) {
                status.textContent =
                  'Search could not load. Please reload or browse the articles above.';
                return;
              }
              const search =
                window.PagefindComponents.getInstanceManager().getInstance(
                  'default'
                );
              const input = document.getElementById('site-search-input');
              let debounce;
              const runSearch = () => {
                window.clearTimeout(debounce);
                debounce = window.setTimeout(
                  () => search.triggerSearch(input.value),
                  150
                );
              };
              input.addEventListener('input', (event) => {
                if (!event.isComposing) runSearch();
              });
              input.addEventListener('compositionend', runSearch);
              input.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' && !event.isComposing) {
                  window.clearTimeout(debounce);
                  search.triggerSearch(input.value);
                }
              });
              search.on('search', (term) => {
                if (input.value !== term) input.value = term;
                input.dispatchEvent(new Event('search-sync'));
                const url = new URL(window.location.href);
                if (term) url.searchParams.set('q', term);
                else url.searchParams.delete('q');
                window.history.replaceState(null, '', url);
              });
              status.hidden = true;
              search.triggerSearch(
                new URLSearchParams(window.location.search).get('q') || ''
              );
            });
          </script>
        </>
      )}
    </div>
  </Section>
</HubPage>

<style>
  #search {
    --pf-text: var(--foreground);
    --pf-mark: var(--foreground);
    --pf-text-secondary: var(--muted-foreground);
    --pf-text-muted: var(--muted-foreground);
    --pf-background: var(--background);
    --pf-border: var(--border);
    --pf-hover: var(--secondary);
    --pf-font: var(--font-sans);
    --pf-border-radius: var(--radius-main);
    --pf-input-height: calc(var(--control-height) + var(--space-1));
    --pf-result-title-font-size: 18px;
    --pf-result-excerpt-font-size: 14px;
  }

  #search :global(pagefind-filter-dropdown) {
    --pf-border: var(--input);
  }

  /* Override Pagefind's mobile centering under the narrow filter trigger. */
  @media (max-width: 640px) {
    #search :global(.pf-dropdown-menu) {
      left: 0 !important;
      transform: none !important;
      width: min(20rem, calc(100vw - 2.5rem)) !important;
    }
  }
</style>
