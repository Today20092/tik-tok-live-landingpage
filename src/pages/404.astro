---
import HubPage from '@/layouts/HubPage.astro';
import Heading from '@/components/lumos/Heading.astro';
const base = import.meta.env.BASE_URL;
---

<HubPage title="Page not found | Islam with Ayoub" path="404/" noindex>
  <main class="page-width page-body">
    <Heading tag="h1" class="page-title">
      Page not found
    </Heading>
    <p class="page-intro">
      That link does not point to a page on Islam with Ayoub.
    </p>
    <nav class="recovery-actions" aria-label="Find your next page">
      <a href={base} class="control control-primary">
        Find books & resources
      </a>
      <a href={`${base}search/`} class="control control-outline">
        Search the site
      </a>
      <a href={`${base}articles/`} class="control control-ghost">
        Browse articles
      </a>
    </nav>
  </main>
</HubPage>

<style>
  @layer components {
    .recovery-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-6);
    }
  }
</style>
