---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found | Islam with Ayoub</title>
  </head>
  <body class="min-h-dvh bg-background text-foreground">
    <main class="mx-auto flex min-h-dvh w-full max-w-2xl flex-col justify-center px-5 py-12 sm:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">404</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</h1>
      <p class="mt-3 max-w-prose leading-relaxed text-muted-foreground">
        That link does not point to a page on Islam with Ayoub.
      </p>
      <a
        href={base}
        class="mt-7 inline-flex min-h-11 w-fit items-center rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-85"
      >
        Return to the homepage
      </a>
    </main>
  </body>
</html>
