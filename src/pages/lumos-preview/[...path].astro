---
import '../../styles/global.css';
import Section from '@/components/lumos/Section.astro';
import Heading from '@/components/lumos/Heading.astro';
import QuoteStylePreview from '@/components/QuoteStylePreview.astro';
import AmazonBookCard from '@/components/AmazonBookCard.astro';
import { getCollection } from 'astro:content';
import ArticleList from '@/components/ArticleList.astro';
import ArticleImageViewer from '@/components/ArticleImageViewer';
import { IconLink } from '@tabler/icons-react';
import chartImage from '../../assets/80000-hours-income-life-satisfaction.png';
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
export function getStaticPaths() {
  return import.meta.env.DEV || import.meta.env.LUMOS_PREVIEW === '1'
    ? [{ params: { path: undefined } }]
    : [];
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Lumos design reference | Islam with Ayoub</title>
  </head>
  <body>
    <Section>
      <QuoteStylePreview />
      <section class="article-page typeset typeset-article">
        <h2>Article book recommendation and footnotes</h2>
        <AmazonBookCard
          id="reference-book"
          title="Men Are from Mars, Women Are from Venus"
          author="John Gray"
          href="https://amzn.to/4yvf9wN"
        />
        <p>
          Follow the footnote and return to highlight this whole paragraph.
          <sup>
            <a id="reference-fnref" href="#reference-fn" data-footnote-ref>
              1
            </a>
          </sup>
        </p>
        <section data-footnotes aria-label="Reference example">
          <ol>
            <li id="reference-fn">
              <p>
                Example reference.{' '}
                <a
                  href="#reference-fnref"
                  data-footnote-backref
                  aria-label="Back to reference example"
                >
                  ↩
                </a>
              </p>
            </li>
          </ol>
        </section>
      </section>
      <Heading tag="h1">One system, across the site</Heading>
      <p class="text-muted">
        Development reference for the Lumos migration experiment.
      </p>
      <div class="reference-grid">
        <section class="reference-panel theme-light">
          <Heading variant="h3">Resource card · light</Heading>
          <a
            class="resource-card resource-card-primary"
            href="https://go.alphabravomedia.co/islam-quran"
          >
            <span class="resource-card_content">
              <span class="resource-card_title">Read Quran in English</span>
              <span class="resource-card_description">
                Free translation & audio on Quran.com
              </span>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        </section>
        <section class="reference-panel theme-dark">
          <Heading variant="h3">Resource card · dark</Heading>
          <a
            class="resource-card"
            href="https://go.alphabravomedia.co/islam-youtube"
          >
            <span class="resource-card_content">
              <span class="resource-card_title">Watch the recordings</span>
              <span class="resource-card_description">
                Catch up with Ayoub on YouTube
              </span>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        </section>
      </div>
      <section class="reading-width">
        <Heading variant="h2">Articles & understanding</Heading>
        <p class="text-muted">Reading notes and explanations from the live.</p>
        <p class="text-style-main">
          Read the Quran, find a copy, and explore the links from our live
          sessions.
        </p>
      </section>
      <section class="reading-width">
        <Heading variant="h2">Article list spacing</Heading>
        <p class="text-muted">
          Compact article lists use full text line boxes and two spacing units
          between the title, description, and reading time, without inherited
          prose heading margins.
        </p>
        <ArticleList articles={articles} heading="h3" />
      </section>
      <section class="site-shell reading-width">
        <h2 class="section-title">Migrated site text spacing</h2>
        <p class="page-intro">
          The shared site shell keeps full line boxes for headings and
          paragraphs, including learning recommendations, resource labels,
          sharing, and footer copy.
        </p>
      </section>
      <section class="article-page">
        <h2 class="section-title">Desktop article reader</h2>
        <p>
          Article pages use a sticky contents rail from 60rem of available width
          and a footnote margin from 78rem. Smaller layouts keep the native
          contents disclosure and endnotes. Text sizing and printing restore the
          single-column reading flow when needed.
        </p>
        <div class="flex-horizontal-wrap gap-3">
          <a
            class="control control-outline"
            href={`${import.meta.env.BASE_URL}articles/article-layout-preview/`}
          >
            Subsections and repeated notes
          </a>
          <a
            class="control control-outline"
            href={`${import.meta.env.BASE_URL}articles/preparing-for-marriage/`}
          >
            Article with margin notes
          </a>
          <a
            class="control control-outline"
            href={`${import.meta.env.BASE_URL}articles/about-me/`}
          >
            Article without notes
          </a>
        </div>
      </section>
      <section class="article-page">
        <header class="article-page_header">
          <p class="article-page_category">Article spacing reference</p>
          <Heading tag="h2" class="page-title">
            A longer article title that wraps onto multiple lines
          </Heading>
          <p class="article-page_description">
            Full line boxes and shared spacing tokens keep the title,
            description, and byline separate.
          </p>
          <p class="article-page_byline">Ayoub · About 8 min read</p>
        </header>
        <div class="typeset typeset-article">
          <h2 class="article-section-heading">
            <span>Article heading with a section link</span>
            <a
              class="control control-ghost control-icon"
              href="#"
              aria-label="Link to section"
            >
              <IconLink aria-hidden="true" />
            </a>
          </h2>
          <p>
            Section headings use full line boxes so the link stays beside the
            text.
          </p>
          <p>
            Paragraphs and quotation text use the same full line boxes, with
            larger gaps between sections than within them.
          </p>
        </div>
      </section>
      <div class="flex-horizontal-wrap gap-3">
        <button class="control control-primary">Primary action</button>
        <button class="control control-outline">Secondary action</button>
        <button class="control control-ghost">Quiet action</button>
        <button class="control control-primary" disabled>
          Disabled action
        </button>
      </div>
      <a class="control control-outline" href={import.meta.env.BASE_URL}>
        Open the site
      </a>
      <section class="reference-panel theme-dark">
        <Heading variant="h3">Intentional theme and layout variants</Heading>
        <p>
          Focus keeps light text over its dark photo overlay. Journal uses the
          secondary surface. Both surrounding layouts follow the selected site
          theme. Ko-fi preview samples retain Ko-fi's orange brand colors.
        </p>
      </section>
      <section class="reading-width">
        <Heading variant="h2">Image viewer</Heading>
        <p class="text-muted">
          The viewer uses a wider dialog for images. Its controls share the
          site's size, focus, and corner tokens.
        </p>
        <img
          data-article-image
          src={chartImage.src}
          width={chartImage.width}
          height={chartImage.height}
          alt="Income and life satisfaction chart for testing the image viewer"
        />
        <ArticleImageViewer client:load />
      </section>
      <section class="reading-width">
        <Heading variant="h2">Book shelf</Heading>
        <p>
          Mobile headers use a compact brand row with theme control and a native
          Menu disclosure; desktop navigation stays visible. The reading cover
          starts one spacing step below the header. The homepage uses the
          cover-and-text reading layout with one title, a primary PDF action and
          a secondary print action. Free-copy eligibility and other editions
          expand into native swipeable shelves on request. Compare the reading
          note, cover-and-text, and text-first variants below. The welcome
          section uses a grid gap to keep heading and paragraph spacing
          consistent without collapsed margins.
        </p>
        <a
          class="control control-outline"
          href={`${import.meta.env.BASE_URL}#books`}
        >
          View book shelf
        </a>
        <a
          class="control control-ghost"
          href={`${import.meta.env.BASE_URL}reading-preview/note/`}
        >
          Compare shelf layouts
        </a>
      </section>
    </Section>
  </body>
</html>
