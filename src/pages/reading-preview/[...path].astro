---
import HubPage from '../../layouts/HubPage.astro';
import PocketHub from '../../components/PocketHub.astro';
export function getStaticPaths() {
  return import.meta.env.DEV ? ['note', 'split', 'minimal'].map((path) => ({ params: { path } })) : [];
}
const layout = Astro.params.path as 'note' | 'split' | 'minimal';
---
<HubPage title="Reading layout comparison | Islam with Ayoub" noindex>
  <PocketHub readingLayout={layout} />
</HubPage>
