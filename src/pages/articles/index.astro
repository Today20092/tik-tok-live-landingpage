---
import { getCollection } from 'astro:content';
import HubPage from '@/layouts/HubPage.astro';
import { buttonVariants } from '@/components/ui/button';
import { IconArrowLeft, IconArrowUpRight } from '@tabler/icons-react';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
---

<HubPage
  title="Articles & understanding | Live with Ayoub"
  description="Articles, reading notes, and explanations from Ayoub's live sessions."
  path="articles/"
>
  <main class="min-h-dvh bg-background px-5 py-8 font-sans text-foreground sm:py-12">
    <div class="mx-auto max-w-2xl">
      <a
        href={base}
        class={buttonVariants({
          variant: 'ghost',
          size: 'lg',
          className: 'min-h-11',
        })}
      >
        <IconArrowLeft data-icon="inline-start" />
        Back to links
      </a>
      <a
        href={`${base}search/`}
        class="ml-4 inline-flex min-h-11 items-center text-sm font-medium underline-offset-4 hover:underline"
      >
        Search the site
      </a>
      <header class="py-8">
        <h1 class="text-3xl font-semibold leading-tight tracking-tight">
          Articles & understanding
        </h1>
        <p class="mt-3 text-muted-foreground">
          Reading notes and explanations from the live.
        </p>
      </header>
      {articles.length ? (
        <div class="grid gap-8">
          {articles.map((article) => (
            <a
              href={`${base}articles/${article.id}/`}
              class="group block border-t border-border pt-6"
            >
              {article.data.cover && (
                <img
                  src={`${base}${article.data.cover.src}`}
                  alt={article.data.cover.alt}
                  width="1200"
                  height="675"
                  loading="lazy"
                  class="mb-4 aspect-video w-full rounded-xl object-cover"
                />
              )}
              <p class="text-xs text-muted-foreground">
                {article.data.category}
              </p>
              <h2 class="mt-2 flex items-center justify-between gap-4 text-xl font-semibold group-hover:underline">
                {article.data.title}
                <IconArrowUpRight size={20} className="shrink-0" />
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {article.data.description}
              </p>
            </a>
          ))}
        </div>
      ) : (
        <p class="border-t border-border py-6 text-muted-foreground">
          No articles published yet. You can find reading links and recordings
          on the main page.
        </p>
      )}
    </div>
  </main>
</HubPage>
