---
import { getCollection } from 'astro:content';
import HubPage from '@/layouts/HubPage.astro';
import ArticleList from '@/components/ArticleList.astro';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<HubPage
  title="Articles & understanding | Islam with Ayoub"
  description="Articles, reading notes, and explanations from Ayoub's live sessions."
  path="articles/"
>
  <main class="mx-auto max-w-5xl px-5 pb-4 pt-8 sm:px-8 sm:pt-10">
    <header class="pb-7">
      <h1 class="text-3xl font-semibold leading-tight tracking-tight">
        Articles & understanding
      </h1>
      <p class="mt-3 text-muted-foreground">
        Reading notes and explanations from the live.
      </p>
    </header>
    {articles.length ? (
      <ArticleList articles={articles} />
    ) : (
      <p class="border-t border-border py-6 text-muted-foreground">
        No articles published yet. You can find reading links and recordings on
        the main page.
      </p>
    )}
  </main>
</HubPage>
