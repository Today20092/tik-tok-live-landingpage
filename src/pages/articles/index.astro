---
import { getCollection } from 'astro:content';
import HubPage from '@/layouts/HubPage.astro';
import Section from '@/components/lumos/Section.astro';
import Heading from '@/components/lumos/Heading.astro';
import ArticleList from '@/components/ArticleList.astro';
import { IconSearch } from '@tabler/icons-react';
const base = import.meta.env.BASE_URL;
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<HubPage
  title="Articles & understanding | Islam with Ayoub"
  description="Read Ayoub's reflections, Quran reading notes, and clear explanations from live sessions, with sources and practical resources to continue learning."
  path="articles/"
>
  <Section
    tag="main"
    paddingTop="small"
    paddingBottom="none"
    gap="0"
    class="page-section article-index"
  >
    <header class="u-pb-7">
      <Heading tag="h1" class="page-title">
        Articles & understanding
      </Heading>
      <p class="index_p">Reading notes and explanations from the live.</p>
      <a
        href={`${base}search/`}
        class="control control-outline article-index-search"
      >
        <IconSearch size={18} aria-hidden="true" /> Search the site
      </a>
    </header>
    {articles.length ? (
      <ArticleList articles={articles} />
    ) : (
      <p class="index_p-2">
        No articles published yet. You can find reading links and recordings on{' '}
        <a href={base} class="u-underline">
          the main page
        </a>
        .
      </p>
    )}
  </Section>
</HubPage>

<style>
  @layer components {
    .article-index-search {
      margin-top: var(--space-5);
    }
  }
</style>
