---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import HubPage from '@/layouts/HubPage.astro';
import Section from '@/components/lumos/Section.astro';
import Heading from '@/components/lumos/Heading.astro';
import { buttonVariants } from '@/components/ui/button';
import ArticleReadingTools from '@/components/article/ArticleReadingTools.astro';
import ArticleMarginNotes from '@/components/article/ArticleMarginNotes.astro';
import ArticleExtras from '@/components/article/ArticleExtras.astro';
import ArticleList from '@/components/article/ArticleList.astro';
import ArticleContents from '@/components/article/ArticleContents.astro';
import { groupContents } from '@/lib/contents';
import { readingTime } from '@/lib/reading-time';
import { categorySlug } from '@/lib/category';
import { IconArrowLeft, IconArrowUpRight } from '@tabler/icons-react';
export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const { sections, contents } = groupContents(headings);
const published = await getCollection('articles', ({ data }) => !data.draft);
const related = article.data.related
  ? article.data.related
      .map((id) => published.find((entry) => entry.id === id))
      .filter((entry): entry is CollectionEntry<'articles'> => Boolean(entry))
  : published
      .filter((entry) => entry.id !== article.id)
      .sort(
        (a, b) =>
          Number(b.data.category === article.data.category) -
            Number(a.data.category === article.data.category) ||
          b.data.date.valueOf() - a.data.date.valueOf()
      )
      .slice(0, 2);
const base = import.meta.env.BASE_URL;
const pageTitle =
  article.id === 'about-me'
    ? 'About Ayoub and Islam | Islam with Ayoub'
    : `${article.data.title} | Islam with Ayoub`;
---

<HubPage
  title={pageTitle}
  description={article.data.description}
  path={`articles/${article.id}/`}
  noindex={article.data.draft}
  publishedTime={article.data.date.toISOString()}
  image={article.data.cover?.src}
  imageAlt={article.data.cover?.alt}
>
  <ArticleReadingTools />
  <ArticleMarginNotes />
  <ArticleExtras />
  <Section
    tag="main"
    paddingTop="small"
    paddingBottom="small"
    gap="0"
    data-pagefind-body={!article.data.draft ? '' : undefined}
    class="page-section article-reader"
  >
    <div
      class:list={[
        'article-page article-page--reader',
        { 'has-contents': sections.length >= 2 },
      ]}
    >
      <nav aria-label="Breadcrumb" class="article-page_breadcrumb">
        <a
          data-pagefind-ignore
          href={`${base}articles/`}
          class={buttonVariants({
            variant: 'ghost',
            size: 'lg',
            className: 'u-min-h-11',
          })}
        >
          <IconArrowLeft data-icon="inline-start" aria-hidden="true" />
          All articles
        </a>
      </nav>
      <header class="article-page_header">
        {article.data.draft && (
          <p class="article-page_draft">
            Draft preview · Not included in the published site
          </p>
        )}
        {article.id !== 'about-me' && (
          <p class="article-page_category">
            <a href={`${base}articles/#${categorySlug(article.data.category)}`}>
              {article.data.category}
            </a>
          </p>
        )}
        <Heading
          tag="h1"
          id="article-top"
          tabindex="-1"
          data-pagefind-meta="title"
          class="page-title"
        >
          {article.data.title}
        </Heading>
        {article.id !== 'about-me' && (
          <p class="article-page_description">{article.data.description}</p>
        )}
        <p class="article-page_byline">
          {article.id !== 'about-me' && (
            <>
              <a href={`${base}articles/about-me/`} class="article-page_author">
                Ayoub
              </a>{' '}
              ·{' '}
            </>
          )}
          <time datetime={article.data.date.toISOString()}>
            {article.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
          <span data-pagefind-ignore>
            {' '}
            · About {readingTime(article.body)} min read
          </span>
        </p>
      </header>
      {article.data.cover && (
        <img
          data-article-image
          src={`${base}${article.data.cover.src}`}
          alt={article.data.cover.alt}
          width="1200"
          height="675"
          fetchpriority="high"
          class="article-page_cover"
        />
      )}
      <ArticleContents sections={contents} />
      <div class="article-page_reading">
        <article id="article-body" class="typeset typeset-article min-width-0">
          <Content />
        </article>
      </div>
      <footer data-pagefind-ignore class="article-page_footer">
        {article.data.resources && (
          <section
            id="article-resources"
            aria-labelledby="mentioned-resources"
            class="u-mb-6"
          >
            <h2 id="mentioned-resources" class="article-page_resources-title">
              Resources mentioned
            </h2>
            <div class="article-page_resources">
              {article.data.resources.map(({ label, url }) => (
                <a href={url} class="article-page_resource">
                  {label} <IconArrowUpRight size={18} aria-hidden="true" />
                </a>
              ))}
            </div>
          </section>
        )}
        {related.length > 0 && (
          <nav aria-labelledby="read-next">
            <h2 id="read-next" class="article-page_related-title">
              Read next
            </h2>
            <ArticleList articles={related} heading="h3" />
          </nav>
        )}
      </footer>
    </div>
  </Section>
</HubPage>
