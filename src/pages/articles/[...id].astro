---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import HubPage from '@/layouts/HubPage.astro';
import Section from '@/components/lumos/Section.astro';
import Heading from '@/components/lumos/Heading.astro';
import { buttonVariants } from '@/components/ui/button';
import ArticleReadingTools from '@/components/ArticleReadingTools.astro';
import ArticleExtras from '@/components/ArticleExtras.astro';
import ArticleList from '@/components/ArticleList.astro';
import { readingTime } from '@/lib/reading-time';
import {
  IconArrowLeft,
  IconList,
  IconChevronDown,
  IconArrowUpRight,
} from '@tabler/icons-react';
export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const sections = headings.filter((heading) => heading.depth === 2);
const published = await getCollection('articles', ({ data }) => !data.draft);
const recommendations: Record<string, string[]> = {
  '80000-hours': ['why-i-started', 'about-me'],
  'why-i-started': ['about-me', '80000-hours'],
  'about-me': ['why-i-started', '80000-hours'],
};
const related = recommendations[article.id]
  ? recommendations[article.id]
      .map((id) => published.find((entry) => entry.id === id))
      .filter((entry): entry is CollectionEntry<'articles'> => Boolean(entry))
  : published
      .filter((entry) => entry.id !== article.id)
      .sort(
        (a, b) =>
          Number(b.data.category === article.data.category) -
            Number(a.data.category === article.data.category) ||
          b.data.date.valueOf() - a.data.date.valueOf()
      )
      .slice(0, 2);
const base = import.meta.env.BASE_URL;
const pageTitle =
  article.id === 'about-me'
    ? 'About Ayoub and Islam | Islam with Ayoub'
    : `${article.data.title} | Islam with Ayoub`;
---

<HubPage
  title={pageTitle}
  description={article.data.description}
  path={`articles/${article.id}/`}
  noindex={article.data.draft}
  publishedTime={article.data.date.toISOString()}
  image={article.data.cover?.src}
  imageAlt={article.data.cover?.alt}
>
  <ArticleReadingTools />
  <ArticleExtras />
  <Section
    tag="main"
    paddingTop="small"
    paddingBottom="small"
    gap="0"
    data-pagefind-body={!article.data.draft ? '' : undefined}
    data-pagefind-filter="Type:Articles"
    class="page-section"
  >
    <div class="article-page">
      <nav aria-label="Breadcrumb" class="article-page_breadcrumb">
        <a
          data-pagefind-ignore
          href={`${base}articles/`}
          class={buttonVariants({
            variant: 'ghost',
            size: 'lg',
            className: 'u-min-h-11',
          })}
        >
          <IconArrowLeft data-icon="inline-start" />
          All articles
        </a>
      </nav>
      <header class="article-page_header">
        {article.data.draft && (
          <p class="article-page_draft">
            Draft preview · Not included in the published site
          </p>
        )}
        <p class="article-page_category">{article.data.category}</p>
        <Heading
          tag="h1"
          id="article-top"
          tabindex="-1"
          data-pagefind-meta="title"
          class="page-title"
        >
          {article.data.title}
        </Heading>
        <p class="article-page_description">{article.data.description}</p>
        <p class="article-page_byline">
          <a
            href={`${base}articles/why-i-started/`}
            class="article-page_author"
          >
            Ayoub
          </a>{' '}
          ·{' '}
          <time datetime={article.data.date.toISOString()}>
            {article.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
          <span data-pagefind-ignore>
            {' '}
            · About {readingTime(article.body)} min read
          </span>
        </p>
      </header>
      {article.data.cover && (
        <img
          data-article-image
          src={`${base}${article.data.cover.src}`}
          alt={article.data.cover.alt}
          width="1200"
          height="675"
          class="article-page_cover"
        />
      )}
      {sections.length >= 2 && (
        <details data-pagefind-ignore class="group article-page_contents">
          <summary class="article-page_contents-toggle">
            <IconList size={18} aria-hidden="true" />
            <span id="article-contents-title">On this page</span>
            <IconChevronDown
              size={16}
              className="article-page_contents-chevron"
              aria-hidden="true"
            />
          </summary>
          <nav aria-labelledby="article-contents-title" class="u-pb-4">
            <ul>
              {sections.map(({ slug, text }) => (
                <li>
                  <a href={`#${slug}`} class="article-page_contents-link">
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}
      <article id="article-body" class="typeset typeset-article min-width-0">
        <Content />
      </article>
      <footer data-pagefind-ignore class="article-page_footer">
        {article.id === 'why-i-started' && (
          <section
            id="article-resources"
            aria-labelledby="mentioned-resources"
            class="u-mb-6"
          >
            <h2 id="mentioned-resources" class="article-page_resources-title">
              Resources mentioned
            </h2>
            <div class="article-page_resources">
              <a href="https://quran.com/16/125" class="article-page_resource">
                Quran 16:125 <IconArrowUpRight size={18} aria-hidden="true" />
              </a>
              <a
                href="https://go.alphabravomedia.co/islam-riyad-pdf"
                class="article-page_resource"
              >
                Riyad as-Salihin PDF{' '}
                <IconArrowUpRight size={18} aria-hidden="true" />
              </a>
            </div>
          </section>
        )}
        {related.length > 0 && (
          <nav aria-labelledby="read-next" class="u-mb-8">
            <h2 id="read-next" class="article-page_related-title">
              Read next
            </h2>
            <ArticleList articles={related} heading="h3" />
          </nav>
        )}
        <a
          href={base}
          class={buttonVariants({
            variant: 'secondary',
            size: 'lg',
            className: 'u-min-h-11',
          })}
        >
          Back to Ayoub's links
        </a>
      </footer>
    </div>
  </Section>
</HubPage>
