---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import HubPage from '@/layouts/HubPage.astro';
import { buttonVariants } from '@/components/ui/button';
import { IconArrowLeft, IconList, IconSearch } from '@tabler/icons-react';
export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const sections = headings.filter((heading) => heading.depth === 2);
const base = import.meta.env.BASE_URL;
---

<HubPage
  title={`${article.data.title} | Live with Ayoub`}
  description={article.data.description}
  path={`articles/${article.id}/`}
  noindex={article.data.draft}
>
  <main
    data-pagefind-body={!article.data.draft ? '' : undefined}
    data-pagefind-filter="Type:Articles"
    class="min-h-dvh bg-background px-5 py-8 font-sans text-foreground sm:py-12"
  >
    <div class="mx-auto max-w-2xl">
      <nav aria-label="Site" class="flex flex-wrap items-center gap-2">
      <a
        data-pagefind-ignore
        href={`${base}articles/`}
        class={buttonVariants({
          variant: 'ghost',
          size: 'lg',
          className: 'min-h-11',
        })}
      >
        <IconArrowLeft data-icon="inline-start" />
        All articles
      </a>
      <a
        data-pagefind-ignore
        href={`${base}search/`}
        class={buttonVariants({ variant: 'ghost', size: 'lg', className: 'min-h-11' })}
      >
        <IconSearch data-icon="inline-start" aria-hidden="true" />
        Search the site
      </a>
      </nav>
      <header class="pb-8 pt-6">
        {article.data.draft && (
          <p class="mb-4 text-sm font-semibold text-primary">
            Draft preview · Not included in the published site
          </p>
        )}
        <p class="text-sm text-muted-foreground">{article.data.category}</p>
        <h1
          data-pagefind-meta="title"
          class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
        >
          {article.data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          {article.data.description}
        </p>
        <p class="mt-4 text-xs text-muted-foreground">
          <time datetime={article.data.date.toISOString()}>
            {article.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
        </p>
      </header>
      {article.data.cover && (
        <img
          src={`${base}${article.data.cover.src}`}
          alt={article.data.cover.alt}
          width="1200"
          height="675"
          class="mb-8 aspect-video w-full rounded-xl object-cover"
        />
      )}
      {sections.length >= 2 && (
        <nav
          data-pagefind-ignore
          aria-labelledby="article-contents-title"
          class="mb-8 rounded-2xl border border-border bg-secondary/50 p-5"
        >
          <h2
            id="article-contents-title"
            class="mb-2 flex items-center gap-2 text-base font-semibold"
          >
            <IconList size={18} aria-hidden="true" /> On this page
          </h2>
          <ul>
            {sections.map(({ slug, text }) => (
              <li>
                <a
                  href={`#${slug}`}
                  class="inline-flex min-h-11 items-center rounded-sm text-sm underline decoration-border underline-offset-4 hover:decoration-current"
                >
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <article class="typeset typeset-article min-w-0 max-w-[65ch]">
        <Content />
      </article>
      <footer data-pagefind-ignore class="mt-12 border-t border-border pt-6">
        <a
          href={base}
          class={buttonVariants({
            variant: 'secondary',
            size: 'lg',
            className: 'min-h-11',
          })}
        >
          Back to Ayoub's links
        </a>
      </footer>
    </div>
  </main>
</HubPage>
