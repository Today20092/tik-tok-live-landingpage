---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import HubPage from '@/layouts/HubPage.astro';
import { buttonVariants } from '@/components/ui/button';
import {
  IconArrowLeft,
  IconList,
  IconChevronDown,
  IconArrowUpRight,
} from '@tabler/icons-react';
export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const sections = headings.filter((heading) => heading.depth === 2);
const base = import.meta.env.BASE_URL;
---

<HubPage
  title={`${article.data.title} | Islam with Ayoub`}
  description={article.data.description}
  path={`articles/${article.id}/`}
  noindex={article.data.draft}
  publishedTime={article.data.date.toISOString()}
  image={article.data.cover?.src}
  imageAlt={article.data.cover?.alt}
>
  <main
    data-pagefind-body={!article.data.draft ? '' : undefined}
    data-pagefind-filter="Type:Articles"
    class="mx-auto max-w-5xl px-5 pb-4 pt-5 sm:px-8 sm:pt-7"
  >
    <div class="mx-auto max-w-3xl">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2">
        <a
          data-pagefind-ignore
          href={`${base}articles/`}
          class={buttonVariants({
            variant: 'ghost',
            size: 'lg',
            className: 'min-h-11',
          })}
        >
          <IconArrowLeft data-icon="inline-start" />
          All articles
        </a>
      </nav>
      <header class="pb-8 pt-6">
        {article.data.draft && (
          <p class="mb-4 text-sm font-semibold text-primary">
            Draft preview · Not included in the published site
          </p>
        )}
        <p class="text-sm text-muted-foreground">{article.data.category}</p>
        <h1
          data-pagefind-meta="title"
          class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
        >
          {article.data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          {article.data.description}
        </p>
        <p class="mt-4 text-sm text-muted-foreground">
          <a
            href={`${base}articles/why-i-started/`}
            class="font-medium text-primary hover:underline"
          >
            Ayoub
          </a>{' '}
          ·{' '}
          <time datetime={article.data.date.toISOString()}>
            {article.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
        </p>
      </header>
      {article.data.cover && (
        <img
          src={`${base}${article.data.cover.src}`}
          alt={article.data.cover.alt}
          width="1200"
          height="675"
          class="mb-8 aspect-video w-full rounded-xl object-cover"
        />
      )}
      {sections.length >= 2 && (
        <details
          data-pagefind-ignore
          class="group mb-8 rounded-lg border border-border bg-secondary/60 px-5"
        >
          <summary class="flex min-h-14 cursor-pointer items-center gap-2 text-sm font-medium">
            <IconList size={18} aria-hidden="true" />
            <span id="article-contents-title">On this page</span>
            <IconChevronDown
              size={16}
              className="ml-auto transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <nav aria-labelledby="article-contents-title" class="pb-4">
            <ul>
              {sections.map(({ slug, text }) => (
                <li>
                  <a
                    href={`#${slug}`}
                    class="inline-flex min-h-11 items-center rounded-sm text-sm underline decoration-border underline-offset-4 hover:decoration-current"
                  >
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}
      <article class="typeset typeset-article min-w-0">
        <Content />
      </article>
      <footer data-pagefind-ignore class="mt-10 border-t border-border pt-6">
        {article.id === 'why-i-started' && (
          <section aria-labelledby="mentioned-resources" class="mb-6">
            <h2 id="mentioned-resources" class="text-lg font-semibold">
              Resources mentioned
            </h2>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <a
                href="https://quran.com/16/125"
                class="flex min-h-16 items-center justify-between gap-3 rounded-lg bg-secondary p-4 text-sm font-medium hover:bg-accent"
              >
                Quran 16:125 <IconArrowUpRight size={18} aria-hidden="true" />
              </a>
              <a
                href="https://go.alphabravomedia.co/riyad-as-salign-pdf"
                class="flex min-h-16 items-center justify-between gap-3 rounded-lg bg-secondary p-4 text-sm font-medium hover:bg-accent"
              >
                Riyad as-Salihin PDF{' '}
                <IconArrowUpRight size={18} aria-hidden="true" />
              </a>
            </div>
          </section>
        )}
        <a
          href={base}
          class={buttonVariants({
            variant: 'secondary',
            size: 'lg',
            className: 'min-h-11',
          })}
        >
          Back to Ayoub's links
        </a>
      </footer>
    </div>
  </main>
</HubPage>
