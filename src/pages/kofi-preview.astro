---
import HubPage from '@/layouts/HubPage.astro';
const base = import.meta.env.BASE_URL;
const url = 'https://go.alphabravomedia.co/islam-kofi';
const logo =
  'https://cdn.prod.website-files.com/5c14e387dab576fe667689cf/670f5a01229bf8a18f97a3c1_favion.avif';
const button = 'kofi-preview_button';
---

<HubPage title="Ko-fi options | Islam with Ayoub" path="kofi-preview/" noindex>
  <main class="kofi-preview_main">
    <div class="kofi-preview_div">
      <a href={base} class="kofi-preview_a">
        Back to the homepage
      </a>
      <h1 class="kofi-preview_h1">Choose a support card</h1>
      <p class="kofi-preview_p">
        Four options for the space above your footer. Each button opens your
        Ko-fi page.
      </p>
      <div class="kofi-preview_div-2">
        <section>
          <h2 class="kofi-preview_h2">A. Soft orange · Recommended</h2>
          <div class="kofi-preview_div-3">
            <img
              src={logo}
              alt="Ko-fi"
              width="48"
              height="48"
              class="kofi-preview_img"
            />
            <h3 class="kofi-preview_h3">Support the live</h3>
            <p class="kofi-preview_p-2">
              Help support these Quran reading sessions.
            </p>
            <a href={url} class={`${button} kofi-preview_a-2`}>
              Support on Ko-fi
            </a>
          </div>
          <p class="kofi-preview_p-3">
            A clear accent that still feels calm beside your green links.
          </p>
        </section>
        <section>
          <h2 class="kofi-preview_h2">B. Full orange</h2>
          <div class="kofi-preview_div-4">
            <img
              src={logo}
              alt="Ko-fi"
              width="48"
              height="48"
              class="kofi-preview_img"
            />
            <h3 class="kofi-preview_h3">Support the live</h3>
            <p class="kofi-preview_p-2">
              Help support these Quran reading sessions.
            </p>
            <a href={url} class={`${button} kofi-preview_a-3`}>
              Support on Ko-fi
            </a>
          </div>
          <p class="kofi-preview_p-3">
            The most noticeable option. Best if support should stand out
            strongly.
          </p>
        </section>
        <section>
          <h2 class="kofi-preview_h2">C. Compact outline</h2>
          <a href={url} class="kofi-preview_a-4">
            <img
              src={logo}
              alt=""
              width="48"
              height="48"
              class="kofi-preview_img-2"
            />
            <span class="flex-grow">
              <span class="kofi-preview_span">Support the live on Ko-fi</span>
              <span class="kofi-preview_span-2">
                Help support these Quran reading sessions.
              </span>
            </span>
          </a>
          <p class="kofi-preview_p-3">
            Keeps the page short. The whole row is clickable.
          </p>
        </section>
        <section>
          <h2 class="kofi-preview_h2">D. Green with an orange button</h2>
          <div class="kofi-preview_div-5">
            <div class="kofi-preview_div-6">
              <img
                src={logo}
                alt="Ko-fi"
                width="40"
                height="40"
                class="kofi-preview_img-3"
              />
              <h3 class="kofi-preview_h3-2">Support the live</h3>
            </div>
            <p class="kofi-preview_p-4">
              Help support these Quran reading sessions.
            </p>
            <a href={url} class={`${button} kofi-preview_a-2`}>
              Support on Ko-fi
            </a>
          </div>
          <p class="kofi-preview_p-3">
            Closest to your existing palette, with color focused on the action.
          </p>
        </section>
      </div>
      <p class="kofi-preview_p-5">
        Logo and orange from the{' '}
        <a href="https://more.ko-fi.com/brand-assets" class="kofi-preview_a-5">
          official Ko-fi creator kit
        </a>
        .
      </p>
    </div>
  </main>
</HubPage>
