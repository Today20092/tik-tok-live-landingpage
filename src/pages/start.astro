---
// Companion page for the printed "Getting to Know Islam" pamphlet. The QR code
// prints go.ayoubabed.xyz/islam, which points here. Content: start/StartContent.mdx.
import HubPage from '@/layouts/HubPage.astro';
import Section from '@/components/lumos/Section.astro';
import Heading from '@/components/lumos/Heading.astro';
import ArticleReadingTools from '@/components/ArticleReadingTools.astro';
import ArticleMarginNotes from '@/components/ArticleMarginNotes.astro';
import ArticleContents from '@/components/ArticleContents.astro';
import StartContent, { getHeadings } from '@/components/start/StartContent.mdx';
import { groupContents } from '@/lib/contents';
import { IconArrowDown } from '@tabler/icons-react';
// The shahada uses the shared Arabic face; articles load it via QuranVerse.
import '@fontsource/amiri-quran/arabic-400.css';

const { contents } = groupContents(getHeadings());
// The reader's likely reasons for scanning the pamphlet's QR code.
const jumps = [
  [
    'what-muslims-believe',
    'What Muslims believe',
    'One God, the prophets, and the Qur’an.',
  ],
  [
    'questions-people-ask',
    'Questions people ask',
    'Common questions about God, Muhammad, Islamic practice, and everyday life.',
  ],
  [
    'visiting-a-mosque',
    'Visiting a mosque',
    'Plan a visit, find out what to wear, and learn what to expect during prayer.',
  ],
  [
    'becoming-muslim',
    'Becoming Muslim',
    'What the declaration of faith means, how to say it, and where to start afterward.',
  ],
];
---

<HubPage
  title="Getting to Know Islam | Islam with Ayoub"
  description="The companion to the printed pamphlet. What Muslims believe and practice, Muslims in the U.S. and worldwide, common questions, visiting a mosque, and how to become Muslim."
  path="start/"
>
  <ArticleReadingTools />
  <ArticleMarginNotes />
  <Section
    tag="main"
    paddingTop="small"
    paddingBottom="small"
    gap="0"
    data-pagefind-body=""
    class="page-section article-reader"
  >
    <div class="article-page article-page--reader has-contents start-page">
      <header class="article-page_header start-hero">
        <img
          class="start-hero_art"
          src={`${import.meta.env.BASE_URL}pamphlet-cover.svg`}
          width="230"
          height="245"
          alt=""
        />
        <span class="start-hero_rule" aria-hidden="true"></span>
        <Heading
          tag="h1"
          id="article-top"
          tabindex="-1"
          data-pagefind-meta="title"
          class="page-title start-hero_title"
        >
          Getting to Know Islam
        </Heading>
        <p class="start-hero_lede">
          If you found this page through the pamphlet, start with whatever
          interests you. Learn what Muslims believe, what happens at a mosque,
          or what it means to become Muslim.
        </p>
        <nav aria-label="Jump to a section">
          <ul class="start-hero_jumps">
            {jumps.map(([slug, label, preview]) => (
              <li>
                <a
                  href={`#${slug}`}
                  data-preview-title={label}
                  data-preview={preview}
                >
                  {label}
                  <IconArrowDown size={18} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>
      <ArticleContents sections={contents} />
      <div class="article-page_reading">
        <article id="article-body" class="typeset typeset-article min-width-0">
          <StartContent />
          <section aria-labelledby="print">
            <h2 id="print">Print copies to share</h2>
            <p>
              Download{' '}
              <a
                href={`${import.meta.env.BASE_URL}printables/#getting-to-know-islam`}
              >
                Getting to Know Islam
              </a>{' '}
              for home printing or find the files and settings for a print shop.
            </p>
          </section>
        </article>
      </div>
    </div>
  </Section>
</HubPage>
