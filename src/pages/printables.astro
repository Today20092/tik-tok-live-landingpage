---
import { statSync } from 'node:fs';
import { IconRotate360 } from '@tabler/icons-react';
import HubPage from '@/layouts/HubPage.astro';
import Section from '@/components/lumos/Section.astro';
import Heading from '@/components/lumos/Heading.astro';
import PrintItem from '@/components/PrintItem.astro';
import SupportCard from '@/components/SupportCard.astro';

const base = import.meta.env.BASE_URL;
const artwork = `${base}downloads/getting-to-know-islam/getting-to-know-islam`;
const bookmark = `${base}downloads/read-the-quran-bookmark/read-the-quran-bookmark`;
const postcardDir = 'downloads/getting-to-know-islam-postcards';
const kb = (file: string) =>
  `${Math.round(statSync(`public/${postcardDir}/${file}`).size / 1024)} KB`;
const postcards = Object.entries({
  god: 'Who do Muslims worship?',
  muhammad: 'Who was Muhammad?',
  quran: 'What is the Qur’an, and where should I start?',
  hadith: 'How is hadith different from the Qur’an?',
  jesus: 'What do Muslims believe about Jesus?',
  'angels-jinn': 'What are angels and jinn?',
  judgment: 'What happens on the Day of Judgment?',
  ramadan: 'Why do Muslims fast during Ramadan?',
  hajj: 'Why do Muslims go to Mecca for hajj?',
  hijab: 'Why do some Muslim women wear hijab?',
  sharia: 'What does Sharia mean in everyday life?',
  'other-faiths': 'What does Islam teach about people of other faiths?',
  'forced-conversion': 'Can someone be forced to become Muslim?',
  civilians: 'What does Islam teach about harming civilians?',
  'muslim-communities': 'Where do Muslims live?',
  'muslims-in-the-us': 'Who are Muslim Americans?',
}).map(([slug, question]) => ({
  question,
  pdf: `${base}${postcardDir}/postcard-${slug}.pdf`,
  thumb: `${base}${postcardDir}/postcard-${slug}.jpg`,
  back: `${base}${postcardDir}/postcard-${slug}-back.jpg`,
}));
const pack = 'getting-to-know-islam-postcards.zip';
---

<HubPage
  title="Free Islamic printables | Islam with Ayoub"
  description="Download free Islamic outreach materials, including the Getting to Know Islam pamphlet and postcards. Print at home on U.S. Letter paper or order folded copies from a print shop."
  path="printables/"
  inlineSupport
>
  <Section
    tag="main"
    paddingTop="small"
    paddingBottom="small"
    gap="0"
    class="page-section"
  >
    <Heading tag="h1" class="page-title">
      Free Islamic printables
    </Heading>
    <div class="typeset">
      <PrintItem
        id="getting-to-know-islam"
        title="Getting to Know Islam"
        previews={[
          {
            src: `${artwork}-outside.jpg`,
            width: 1584,
            height: 1224,
            alt: 'Outside panels showing Muslims in the United States, common questions, and the front cover.',
            caption: 'Outside of the trifold',
          },
          {
            src: `${artwork}-inside.jpg`,
            width: 1584,
            height: 1224,
            alt: 'Inside panels showing what Muslims believe, the Five Pillars, and Jesus and Mary in Islam.',
            caption: 'Inside of the trifold',
          },
        ]}
        download={{
          href: `${artwork}-us-letter.pdf`,
          label: 'Download the U.S. Letter PDF',
        }}
        shop={{
          href: 'https://www.55printing.com/brochure-printing/',
          label: 'Order from 55printing',
          order:
            '8.5 × 11 inches flat, Tri-Fold, 100 lb. Gloss Book (5 pt.), Full Color Both Sides.',
        }}
      >
        <p>
          An English trifold introducing Islamic beliefs and practices.{' '}
          <a href={`${base}start/`}>Read the online companion</a>.
        </p>

        <Fragment slot="details">
          <h3>Print at home</h3>
          <ol>
            <li>
              Use U.S. Letter paper (8.5 × 11 inches), landscape orientation,
              and color. Print on both sides and flip on the short edge.
            </li>
            <li>
              Print one test copy at Actual Size (100%). If your printer clips
              artwork at the edges, select Fit to printable area.
            </li>
            <li>
              Fold along the panel boundaries. Tuck the narrower panel in first,
              then fold the cover over it.
            </li>
          </ol>

          <h3>Order from a print shop</h3>
          <p>
            Print shops need the outside and inside as separate files. I used
            55printing for the first run; a local print shop works too.
          </p>
          <div class="print-actions" data-not-typeset>
            <a
              href={`${artwork}-outside.pdf`}
              download
              class="control control-outline"
            >
              Download the outside PDF (front)
            </a>
            <a
              href={`${artwork}-inside.pdf`}
              download
              class="control control-outline"
            >
              Download the inside PDF (back)
            </a>
          </div>
          <p>
            Request a digital PDF proof and check the trim, folds, and panel
            order before approving. Check your printing and shipping total at
            checkout.
          </p>

          <h3>Usage rights</h3>
          <p>
            <strong>Free to share. Not for resale.</strong>
          </p>
          <p>
            © 2026 Ayoub Abedrabbo. You may download, print, and share unchanged
            copies of <em>Getting to Know Islam</em> free of charge. Keep the
            existing credits intact. You may pay a print shop to produce copies
            for free distribution. Do not sell copies or distribute modified
            versions without permission. Third-party material remains subject to
            its own terms.
          </p>
          <p>
            Iftar photo by{' '}
            <a href="https://unsplash.com/photos/a-person-eating-a-meal-with-many-dishes-on-table-j70UasSzZEQ">
              Cemrecan Yurtman
            </a>
            , used under the{' '}
            <a href="https://unsplash.com/license">Unsplash License</a>.
          </p>
        </Fragment>
      </PrintItem>

      <PrintItem
        id="read-the-quran-bookmark"
        title="Read the Qur’an bookmark"
        previews={[
          {
            src: `${bookmark}-front.jpg`,
            width: 288,
            height: 1008,
            alt: 'Bookmark front: an eight-point star strapwork headpiece on deep green.',
            caption: 'Front of the bookmark',
          },
          {
            src: `${bookmark}-back.jpg`,
            width: 288,
            height: 1008,
            alt: 'Bookmark back: a Start here checklist of Al-Ikhlas (chapter 112, 4 verses), Al-Fatihah (chapter 1, 7 verses) and Maryam (chapter 19, 98 verses), with a QR code for go.ayoubabed.xyz/islam.',
            caption: 'Back of the bookmark',
          },
        ]}
        download={{
          href: `${bookmark}-print.pdf`,
          label: 'Download the print PDF',
        }}
        shop={{
          href: 'https://www.55printing.com/bookmark-printing/',
          label: 'Order from 55printing',
          order:
            '2 × 7 inches, Full Color Both Sides, 16 pt. Premium Matte or 14 pt. Uncoated. Matte stock reads without glare.',
        }}
      >
        <p>
          A 2 × 7 inch bookmark with a short “Start here” reading list, shortest
          chapter first, and a QR code to read the Qur’an in English. The PDF
          has front and back pages with a 0.05 inch bleed.
        </p>
      </PrintItem>

      <section aria-labelledby="getting-to-know-islam-postcards">
        <h2 id="getting-to-know-islam-postcards">
          Getting to Know Islam postcards
        </h2>
        <p>
          Sixteen postcards, each with a common question on the front and a
          short answer on the back. They are print-ready 4 × 6 inch postcards
          with a 0.05 inch bleed (each PDF page is 4.1 × 6.1 inches), made for
          printing at a print shop. Tap or swipe a card to see its back.
        </p>
        <div class="print-actions" data-not-typeset>
          <a
            href={`${base}${postcardDir}/${pack}`}
            download
            class="control control-outline"
          >
            Download all 16 postcards (ZIP, {kb(pack)})
          </a>
        </div>
        <ul class="postcard-list" data-not-typeset>
          {postcards.map((card) => (
            <li>
              <button
                type="button"
                class="postcard-flip"
                aria-pressed="false"
                aria-label={`Show the back: ${card.question}`}
              >
                <span class="postcard-inner">
                  <img
                    src={card.thumb}
                    width="296"
                    height="440"
                    loading="lazy"
                    alt=""
                  />
                  <img
                    src={card.back}
                    width="296"
                    height="440"
                    loading="lazy"
                    alt=""
                    class="postcard-back"
                  />
                </span>
                <span class="postcard-hint" aria-hidden="true">
                  <IconRotate360 />
                </span>
              </button>
              <a
                href={card.pdf}
                download
                class="control control-outline"
                aria-label={`Download PDF: ${card.question}`}
              >
                Download PDF
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="printables-feedback">
        <h2 id="printables-feedback">Suggestions and requests</h2>
        <p>
          Spotted a mistake, have a concern, or want a printable that isn't
          here yet? Send me a message on{' '}
          <a href="https://go.alphabravomedia.co/islam-tiktok">TikTok</a> and
          I'll fix or update the materials, in sha Allah.
        </p>
      </section>

      <section aria-labelledby="support-dawah">
        <h2 id="support-dawah">Support the dawah work</h2>
        <p>
          These materials stay free. If they helped you share Islam, you can
          support the time and printing costs behind them.
        </p>
        <SupportCard compact />
      </section>
    </div>
  </Section>
</HubPage>

<style>
  .postcard-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-5) var(--space-4);
    margin-block: var(--space-5);
    padding: 0;
    list-style: none;
  }
  .postcard-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .postcard-list .control {
    width: 100%;
  }
  .postcard-flip {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    perspective: 900px;
    /* Vertical swipes still scroll the page; horizontal ones flip. */
    touch-action: pan-y;
    user-select: none;
    scale: 1;
    transition: scale 150ms ease-out;
  }
  .postcard-flip:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 4px;
  }
  .postcard-inner {
    display: grid;
    transform-style: preserve-3d;
    rotate: y calc(var(--side, 0deg) + var(--drag, 0deg) + var(--hint, 0deg));
    transition: rotate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Spatial hints only when motion is welcome: a press dip, a hover tilt,
     and the one-time peek. The corner badge carries the hint otherwise. */
  @media (prefers-reduced-motion: no-preference) {
    .postcard-flip:active {
      scale: 0.98;
    }
    .postcard-flip.is-peeking .postcard-inner {
      --hint: -55deg;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .postcard-flip:hover .postcard-inner {
      --hint: -12deg;
    }
  }
  .postcard-flip.is-dragging .postcard-inner {
    transition: none;
  }
  .postcard-inner img {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: auto;
    backface-visibility: hidden;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
    -webkit-user-drag: none;
  }
  .postcard-inner .postcard-back {
    rotate: y 180deg;
  }
  /* Stays put while the card turns, so it shows on both sides. It sits on
     the top corner, over the front's pattern and the back's blank margin. */
  .postcard-hint {
    position: absolute;
    inset-block-start: calc(var(--space-2) * -1);
    inset-inline-end: calc(var(--space-2) * -1);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
    pointer-events: none;
  }
  .postcard-hint svg {
    width: 1.125rem;
    height: 1.125rem;
    rotate: 0deg;
    transition: rotate 0.5s ease;
  }
  .postcard-flip[aria-pressed='true'] .postcard-hint svg {
    rotate: 180deg;
  }
</style>

<script>
  // Tap flips; a horizontal swipe turns the card with the finger and flips
  // past a quarter of its width, otherwise it springs back.
  for (const card of document.querySelectorAll<HTMLButtonElement>('.postcard-flip')) {
    const question = card.getAttribute('aria-label')!.replace(/^Show the back: /, '');
    let startX = 0;
    let dx = 0;
    let swiped = false;
    let tracking = false;
    // Running angle, so a card keeps turning the way it was swiped.
    let angle = 0;

    const flip = (direction = 1) => {
      angle += 180 * direction;
      card.style.setProperty('--side', `${angle}deg`);
      const back = angle % 360 !== 0;
      card.setAttribute('aria-pressed', String(back));
      card.setAttribute('aria-label', `${back ? 'Show the front' : 'Show the back'}: ${question}`);
    };

    card.addEventListener('click', () => {
      if (swiped) swiped = false;
      else flip();
    });
    card.addEventListener('pointerdown', (e) => {
      tracking = true;
      startX = e.clientX;
      dx = 0;
    });
    card.addEventListener('pointermove', (e) => {
      if (!tracking) return;
      dx = e.clientX - startX;
      if (!card.classList.contains('is-dragging') && Math.abs(dx) > 8) {
        card.classList.add('is-dragging');
        card.setPointerCapture(e.pointerId);
      }
      if (card.classList.contains('is-dragging')) {
        const turn = Math.max(-180, Math.min(180, (dx / card.offsetWidth) * 180));
        card.style.setProperty('--drag', `${turn}deg`);
      }
    });
    const end = () => {
      if (!tracking) return;
      tracking = false;
      if (!card.classList.contains('is-dragging')) return;
      card.classList.remove('is-dragging');
      card.style.removeProperty('--drag');
      swiped = true;
      if (Math.abs(dx) > card.offsetWidth / 4) flip(Math.sign(dx));
      // No click follows a cancelled pointer; reset so the next tap works.
      setTimeout(() => (swiped = false), 0);
    };
    card.addEventListener('pointerup', end);
    card.addEventListener('pointercancel', end);
  }

  // The first time the postcards come into view, the first row turns partway
  // and settles back, showing that each card has a back.
  const list = document.querySelector('.postcard-list');
  if (list && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seen.disconnect();
        const cards = [...list.querySelectorAll<HTMLElement>('.postcard-flip')];
        const firstRow = cards.filter((c) => c.offsetTop === cards[0].offsetTop);
        firstRow.forEach((card, i) => {
          setTimeout(() => card.classList.add('is-peeking'), 400 + i * 150);
          setTimeout(() => card.classList.remove('is-peeking'), 1000 + i * 150);
        });
      },
      // Watch the first card: the whole list is taller than a phone screen.
      { threshold: 0.7 }
    );
    seen.observe(list.querySelector('.postcard-flip')!);
  }
</script>
