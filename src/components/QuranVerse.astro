---
import '@fontsource/amiri-quran/arabic-400.css';
import verses from '@/data/quran-verses.json';

interface Props {
  verse: keyof typeof verses;
}

const { verse } = Astro.props;
if (!Object.hasOwn(verses, verse)) {
  throw new Error(
    `Quran verse ${verse} has no checked text in src/data/quran-verses.json.`
  );
}
const entry = verses[verse];
const { arabic, translation, translator } = entry;
const reference = 'reference' in entry ? entry.reference : verse;
const excerpt = 'excerpt' in verses[verse] && verses[verse].excerpt;
const source = `https://quran.com/${reference.replace(':', '/')}${translator === 'M. A. S. Abdel Haleem' ? '?translations=85' : ''}`;
---

<figure
  data-not-typeset
  data-quran-verse={verse}
  dir="ltr"
  class="quran-verse_figure"
>
  <blockquote cite={source} class="quran-verse_blockquote">
    <p lang="ar" dir="rtl" class="quotation_arabic">
      {arabic}
    </p>
    <p lang="en" dir="ltr" class="quran-verse_p-2">
      {translation}
    </p>
  </blockquote>
  <figcaption class="quran-verse_figcaption">
    <a href={source} class="quran-verse_a">
      Quran {reference}
      {excerpt ? ' (excerpt)' : ''} · Read on Quran.com
    </a>
    <span>Translation by {translator}</span>
  </figcaption>
</figure>
