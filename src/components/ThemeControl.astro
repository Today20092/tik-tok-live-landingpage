---
import { IconSun, IconMoon } from '@tabler/icons-react';
---

<button
  class="control control-ghost control-icon"
  type="button"
  data-theme-control
  aria-label="Switch color theme"
>
  <IconSun className="theme-icon-light" size={18} aria-hidden="true" />
  <IconMoon className="theme-icon-dark" size={18} aria-hidden="true" />
</button>
<script>
  const control = document.querySelector<HTMLButtonElement>(
    '[data-theme-control]'
  );
  const apply = (dark: boolean) => {
    document.documentElement.classList.toggle('dark', dark);
    document
      .querySelector('meta[name="color-scheme"]')
      ?.setAttribute('content', dark ? 'dark' : 'light');
    // Browser chrome follows the page background (light: primary, dark: ink).
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', dark ? '#11191b' : '#335966');
    control?.setAttribute(
      'aria-label',
      dark ? 'Switch to light theme' : 'Switch to dark theme'
    );
  };
  apply(document.documentElement.classList.contains('dark'));
  control?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    apply(dark);
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      /* Theme still works when storage is unavailable. */
    }
  });
  // Keep other open tabs in step with the remembered choice.
  window.addEventListener('storage', (event) => {
    if (event.key === 'theme') apply(event.newValue === 'dark');
  });
</script>
