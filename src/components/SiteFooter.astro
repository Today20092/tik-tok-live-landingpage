---
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const support = (await getCollection('links')).find(({ data }) => data.variant === 'support')?.data;
---

<footer data-site-footer data-pagefind-ignore class="site-footer">
  <div class="site-footer_content">
    <div>
      <a href={base} class="site-footer_brand">
        Islam with Ayoub
      </a>
      <p class="text-small">For anyone curious about the Quran.</p>
    </div>
    <nav aria-label="Ayoub's social profiles" class="site-footer_socials">
      <a
        class="site-footer_link"
        href="https://go.alphabravomedia.co/islam-tiktok"
      >
        TikTok
      </a>
      <a
        class="site-footer_link"
        href="https://go.alphabravomedia.co/islam-twitch"
      >
        Twitch
      </a>
      <a
        class="site-footer_link"
        href="https://go.alphabravomedia.co/islam-youtube"
      >
        YouTube
      </a>
    </nav>
    <div class="site-footer_information">
      {support && <a href={support.url} class="site-footer_about"><span>Support my work on Ko-fi</span> <span aria-hidden="true">↗</span></a>}
      <a
        href="https://go.alphabravomedia.co/islam-about-ayoub"
        class="site-footer_about"
      >
        About Ayoub <span aria-hidden="true">↗</span>
      </a>
      <details class="group u-max-w-lg">
        <summary class="site-footer_disclosure">
          Site information & privacy
          <span aria-hidden="true" class="site-footer_chevron">
            ▾
          </span>
        </summary>
        <p class="site-footer_copy">
          Links shared by Ayoub during live Quran readings. Contact me through
          the profiles above. This site has no forms, accounts, or sign-ins.
          Resource and profile links use our Cloudflare-hosted Sink shortener to
          record link visits and help us understand which links people use.
          Linked services have their own privacy policies.
        </p>
      </details>
    </div>
  </div>
</footer>
