---
const base = import.meta.env.BASE_URL;
---

<footer
  data-site-footer
  data-pagefind-ignore
  class="mx-auto mt-10 w-full max-w-4xl px-5 pb-8 text-sm text-muted-foreground sm:px-8"
>
  <div class="border-t border-border pt-6">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <a
        href={base}
        class="inline-flex min-h-11 items-center font-serif text-base font-semibold text-foreground"
      >
        Islam with Ayoub
      </a>
      <nav aria-label="Ayoub's social profiles" class="flex gap-5 text-xs">
        <a
          class="inline-flex min-h-11 items-center hover:underline"
          href="https://www.tiktok.com/@ayoubabedrabbo"
        >
          TikTok
        </a>
        <a
          class="inline-flex min-h-11 items-center hover:underline"
          href="https://www.twitch.tv/ayoubabedrabbo"
        >
          Twitch
        </a>
        <a
          class="inline-flex min-h-11 items-center hover:underline"
          href="https://www.youtube.com/channel/UCQ5YfTwU5n_khZx-WJEkZKQ"
        >
          YouTube
        </a>
      </nav>
    </div>
    <p class="text-xs">For anyone curious about the Quran.</p>
    <a
      href="https://ayoubabed.xyz/"
      class="inline-flex min-h-11 items-center rounded-sm text-xs text-foreground underline underline-offset-4 hover:text-primary"
    >
      About Ayoub & my work
    </a>
    <details class="mt-2 text-xs">
      <summary class="inline-flex min-h-11 cursor-pointer items-center underline decoration-current/30 underline-offset-4">
        About & privacy
      </summary>
      <p class="max-w-lg pb-3 leading-relaxed">
        Links shared by Ayoub during live Quran readings. Contact me through the
        profiles above. This site has no forms, accounts, or sign-ins. Linked
        services have their own privacy policies.
      </p>
      <a
        href={`${base}articles/why-i-started/`}
        class="inline-flex min-h-11 items-center underline underline-offset-4"
      >
        Why I started Islam with Ayoub
      </a>
    </details>
  </div>
</footer>
