---
const base = import.meta.env.BASE_URL;
---

<footer
  data-site-footer
  data-pagefind-ignore
  class="mx-auto mt-10 w-full max-w-5xl px-5 pb-8 text-sm text-muted-foreground sm:px-8"
>
  <div class="border-t border-border pt-6">
    <div>
      <a
        href={base}
        class="inline-flex min-h-11 items-center font-serif text-base font-semibold text-foreground"
      >
        Islam with Ayoub
      </a>
      <p class="text-sm">For anyone curious about the Quran.</p>
    </div>
    <nav
      aria-label="Ayoub's social profiles"
      class="mt-3 flex flex-wrap gap-x-5 text-sm"
    >
      <a
        class="inline-flex min-h-11 items-center rounded-sm underline decoration-current/30 underline-offset-4 hover:text-primary"
        href="https://go.alphabravomedia.co/islam-tiktok"
      >
        TikTok
      </a>
      <a
        class="inline-flex min-h-11 items-center rounded-sm underline decoration-current/30 underline-offset-4 hover:text-primary"
        href="https://go.alphabravomedia.co/islam-twitch"
      >
        Twitch
      </a>
      <a
        class="inline-flex min-h-11 items-center rounded-sm underline decoration-current/30 underline-offset-4 hover:text-primary"
        href="https://go.alphabravomedia.co/islam-youtube"
      >
        YouTube
      </a>
    </nav>
    <div class="flex flex-wrap items-start gap-x-5 text-sm">
      <a
        href="https://go.alphabravomedia.co/islam-about-ayoub"
        class="inline-flex min-h-11 items-center gap-1 rounded-sm underline decoration-current/30 underline-offset-4 hover:text-primary"
      >
        About Ayoub <span aria-hidden="true">↗</span>
      </a>
      <details class="group max-w-lg">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-sm underline decoration-current/30 underline-offset-4 hover:text-primary">
          Site information & privacy
          <span
            aria-hidden="true"
            class="transition-transform group-open:rotate-180 motion-reduce:transition-none"
          >
            ▾
          </span>
        </summary>
        <p class="max-w-lg pb-3 leading-relaxed">
          Links shared by Ayoub during live Quran readings. Contact me through
          the profiles above. This site has no forms, accounts, or sign-ins.
          Resource and profile links use our Cloudflare-hosted Sink shortener
          to record link visits and help us understand which links people use.
          Linked services have their own privacy policies.
        </p>
      </details>
    </div>
  </div>
</footer>
