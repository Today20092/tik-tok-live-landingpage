---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { IconChevronDown } from '@tabler/icons-react';
import cover from '../assets/books/riyad-as-salihin.webp';
import clearLiveCover from '../assets/books/clear-quran-arabic-english.png';
import haleemCover from '../assets/books/abdel-haleem-paperback-generated.png';
import parallelCover from '../assets/books/abdel-haleem-hardcover-generated.png';
interface Props {
  layout?: 'note' | 'split' | 'minimal';
}
const { layout = 'split' } = Astro.props;
const links = (await getCollection('links')).map(({ data }) => data);
function resource(icon: string) {
  const link = links.find((item) => item.icon === icon);
  if (!link) throw new Error(`Missing reading resource: ${icon}`);
  return link.url;
}
const freeCopies = [
  {
    title: 'The Clear Quran',
    note: 'For non-Muslims in the USA. One free copy per order.',
    label: 'Request a free copy',
    url: resource('Mail'),
  },
  {
    title: 'The Quran Project',
    note: 'Free for non-Muslims. Check delivery eligibility and postage.',
    label: 'Check eligibility',
    url: resource('PackageOpen'),
  },
];
const paidEditions = [
  {
    title: 'The Quran · Abdel Haleem',
    image: haleemCover,
    note: 'English paperback. The translation I normally quote in articles.',
    label: 'View paperback',
    url: 'https://amzn.to/4dxs7C8',
  },
  {
    title: 'The Quran · Parallel text',
    image: parallelCover,
    note: 'Arabic + English hardcover. Translated by M. A. S. Abdel Haleem.',
    label: 'View hardcover',
    url: 'https://amzn.to/4xS97GV',
  },
];
---

<section
  id="books"
  class:list={['reading-resources', `reading-resources--${layout}`]}
  aria-labelledby="reading-title"
>
  <h1 id="reading-title" class="page-title">
    Books I read on live
  </h1>
  <p class="page-intro">
    Find your book below. No purchase or prior knowledge needed to join.
  </p>
  <div class="reading-live-books">
    <div class="reading-feature">
      <div class="reading-cover">
        <span class="live-book-cover hadith-live-cover">
          <Image
            src={cover}
            alt="Red cover of Riyad as-Salihin"
            width={400}
            loading="eager"
          />
        </span>
      </div>
      <div class="reading-copy">
        <h2>Meadows of the Righteous</h2>
        <p class="reading-label">Hadith collection</p>
        <p class="reading-subtitle">Riyad as-Salihin · Imam an-Nawawi</p>
        <p>
          Reports of what Prophet Muhammad said and did, with Quran passages.
        </p>
      </div>
      <div class="reading-actions">
        <a class="control control-primary" href={resource('Scroll')}>
          Free PDF ↗
        </a>
        <a
          class="control control-outline"
          href="https://turath.co.uk/products/riyad-as-salihin-abridged-and-annotated"
        >
          My print edition ↗
        </a>
      </div>
    </div>
    <div class="reading-feature">
      <div class="reading-cover">
        <span class="live-book-cover clear-live-cover">
          <Image
            src={clearLiveCover}
            alt="Burgundy and gold cover of The Clear Quran with Arabic Text"
            width={832}
            loading="eager"
          />
        </span>
      </div>
      <div class="reading-copy">
        <h2>The Clear Quran</h2>
        <p class="reading-label">Quran · Arabic + English</p>
        <p>Spiral binding added locally; not included with this edition.</p>
      </div>
      <div class="reading-actions">
        <a class="control control-primary" href={resource('Book')}>
          Find this edition ↗
        </a>
      </div>
    </div>
  </div>
  <slot name="support" />
  <section
    id="copies"
    class="reading-links"
    aria-labelledby="quran-resources-title"
  >
    <h2 id="quran-resources-title" class="section-title">
      Quran resources
    </h2>
    <a class="resource-card resource-card-primary" href={resource('BookOpen')}>
      <span class="resource-card_content">
        <span class="resource-card_title">Read the Quran online</span>{' '}
        <span class="resource-card_description">
          Free English translation and audio on Quran.com.
        </span>{' '}
        <span class="resource-card_action">
          Start reading <span aria-hidden="true">↗</span>
        </span>
      </span>
    </a>
    <section class="reading-free-copies" aria-labelledby="free-copies-title">
      <h3 id="free-copies-title">Free printed copies</h3>
      <div class="resource-grid">
        {freeCopies.map((book) => (
          <a class="resource-card" href={book.url}>
            <span class="resource-card_content">
              <span class="resource-card_title">{book.title}</span>{' '}
              <span class="resource-card_description">{book.note}</span>{' '}
              <span class="resource-card_action">
                {book.label} <span aria-hidden="true">↗</span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>
    <details>
      <summary class="resource-card">
        <span class="resource-card_content">
          <span class="resource-card_title">Other Quran editions</span>{' '}
          <span class="resource-card_description">
            Browse paid English and Arabic–English editions.
          </span>
        </span>
        <IconChevronDown size={20} aria-hidden="true" />
      </summary>
      <div class="reading-expanded">
        <div class="reading-editions-grid">
          {paidEditions.map((book) => (
            <article class="reading-book">
              <div class="reading-book-cover">
                <Image
                  src={book.image}
                  alt={`${book.title} cover illustration`}
                  width={400}
                  loading="lazy"
                />
              </div>
              <h3>{book.title}</h3>
              <p>{book.note}</p>
              <a
                class="control control-outline"
                href={book.url}
                rel={book.url.includes('amzn.to') ? 'sponsored' : undefined}
              >
                {book.label} ↗
              </a>
            </article>
          ))}
        </div>
        <p class="reading-caption">
          Paid editions. Amazon links are affiliate links; I earn from
          qualifying purchases.
        </p>
      </div>
    </details>
  </section>
</section>

<style>
  @layer components {
    .reading-resources {
      margin-block: 0 var(--space-8);
    }
    .reading-live-books {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
      margin-block: var(--space-4);
    }
    .reading-resources .reading-live-books .reading-feature {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
      grid-row: span 4;
      gap: var(--space-3);
      padding: 0;
      min-width: 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      align-content: start;
    }
    .reading-live-books .reading-cover {
      grid-row: 1;
    }
    .reading-live-books .reading-copy {
      grid-row: span 2;
      align-content: start;
    }
    .reading-live-books .reading-cover img {
      height: 8rem;
    }
    /* The bookstore photo includes white margins around the actual cover. */
    .live-book-cover {
      display: block;
      position: relative;
      height: 8rem;
      overflow: hidden;
    }
    .clear-live-cover {
      aspect-ratio: 633 / 891;
    }
    .hadith-live-cover {
      aspect-ratio: 632 / 946;
    }
    /* Remove the source artwork's empty margins, preserving the cover ratio. */
    .reading-resources .reading-live-books .hadith-live-cover img {
      position: absolute;
      max-width: none;
      width: 170.89%;
      height: 114.16%;
      left: -32.91%;
      top: -5.07%;
      filter: none;
    }
    .reading-resources .reading-live-books .clear-live-cover img {
      position: absolute;
      max-width: none;
      width: 131.44%;
      height: 140.07%;
      left: -15.8%;
      top: -20.09%;
      filter: none;
    }
    .reading-feature {
      display: grid;
      gap: var(--space-5);
      padding: var(--space-6);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-main);
    }
    .reading-cover {
      display: grid;
      place-items: center;
      padding: var(--space-5);
    }
    .reading-cover img {
      width: auto;
      height: 8rem;
      max-width: 100%;
      object-fit: contain;
      filter: drop-shadow(
        3px 5px 4px color-mix(in srgb, var(--foreground) 14%, transparent)
      );
    }
    .reading-copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
      min-width: 0;
      align-content: center;
    }
    .reading-copy > *,
    .reading-links p {
      margin: 0;
    }
    .reading-copy h2 {
      font-family: var(--font-serif);
      font-size: var(--text-2xl);
      line-height: var(--leading-tight);
      text-wrap: balance;
    }
    .reading-label {
      color: var(--primary);
      font-size: var(--text-small);
      font-weight: 600;
    }
    .reading-subtitle,
    .reading-caption {
      color: var(--muted-foreground);
      font-size: var(--text-small);
    }
    .reading-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding-top: var(--space-2);
    }
    .reading-actions a {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
      min-height: var(--control-height);
      display: inline-flex;
      align-items: center;
      white-space: normal;
    }
    .reading-actions a:not(.control),
    .reading-expanded a {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
    .reading-links {
      margin-top: var(--space-8);
      padding-top: var(--space-6);
      border-top: 1px solid var(--border);
    }
    .reading-links > h2 {
      margin: 0 0 var(--space-4);
    }
    .reading-links details {
      margin-top: var(--space-3);
    }
    .reading-free-copies {
      display: grid;
      gap: var(--space-3);
      margin-block: var(--space-6);
    }
    .reading-free-copies h3 {
      margin: 0;
      font: 600 var(--text-lg)/var(--leading-tight) var(--font-sans);
    }
    .reading-links summary {
      list-style: none;
      cursor: pointer;
    }
    .reading-links summary::marker {
      content: '';
    }
    .reading-links summary::-webkit-details-marker {
      display: none;
    }
    .reading-links details[open] summary :global(svg) {
      transform: rotate(180deg);
    }
    .reading-expanded {
      display: grid;
      gap: var(--space-4);
      padding-block: var(--space-2) var(--space-5);
      color: var(--muted-foreground);
    }
    .reading-expanded a {
      color: var(--foreground);
    }
    .reading-editions-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 12rem auto 1fr auto;
      gap: var(--space-3) var(--space-4);
    }
    .reading-book {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 4;
      min-width: 0;
      color: var(--foreground);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-main);
      overflow: hidden;
    }
    .reading-book > :not(.reading-book-cover) {
      margin-inline: var(--space-4);
    }
    .reading-book-cover {
      display: grid;
      place-items: center;
      padding: var(--space-4);
      min-height: 0;
    }
    .reading-book-cover img {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: contain;
    }
    .reading-book h3 {
      font-size: var(--text-lg);
      line-height: var(--leading-tight);
    }
    .reading-book p {
      font-size: var(--text-small);
      color: var(--muted-foreground);
    }
    .reading-book a {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
      margin-block: var(--space-2) var(--space-4);
      white-space: normal;
      text-decoration: none;
      align-self: stretch;
    }
    .reading-resources--split .reading-feature {
      grid-template-columns: minmax(8rem, 1fr) minmax(0, 2fr);
      background: transparent;
      border: 0;
      padding: 0;
    }
    .reading-resources--split .reading-cover {
      background: var(--secondary);
      border-radius: var(--radius-main);
    }
    .reading-resources--split .reading-cover img {
      height: 11rem;
    }
    .reading-resources--minimal .reading-feature {
      border: 0;
      border-block: 1px solid var(--border);
      background: transparent;
      border-radius: 0;
      padding-inline: 0;
    }
    .reading-resources--minimal .reading-cover {
      display: none;
    }
    .reading-resources--minimal .reading-actions .control {
      background: transparent;
      color: var(--primary);
      padding-inline: 0;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
    @media (width < 40rem) {
      .reading-live-books {
        grid-template-columns: minmax(0, 1fr);
      }
      .reading-resources .reading-live-books .reading-feature {
        grid-template-columns: minmax(0, min(4.5rem, 20%)) minmax(0, 1fr);
        grid-template-rows: auto;
        grid-row: auto;
        column-gap: var(--space-4);
        row-gap: var(--space-3);
        padding-bottom: var(--space-5);
        border-radius: 0;
      }
      .reading-resources .reading-live-books .reading-cover {
        grid-column: 1;
        grid-row: 1 / span 2;
        align-self: start;
        padding: 0;
        background: transparent;
        border-radius: 0;
      }
      .reading-live-books .reading-copy {
        grid-column: 2;
        grid-row: 1;
      }
      .reading-live-books .reading-copy > p {
        font-size: var(--text-small);
      }
      .reading-live-books .reading-actions {
        grid-column: 2;
        padding-top: 0;
        gap: var(--space-2);
      }
      .reading-live-books .reading-actions .control {
        font-size: var(--text-small);
      }
      .reading-live-books .reading-copy h2 {
        font-size: var(--text-xl);
      }
      .reading-resources .reading-live-books .reading-cover > img {
        height: 5rem;
      }
      .reading-live-books .live-book-cover {
        height: 6rem;
        max-width: 100%;
      }
      .reading-resources--minimal .reading-live-books .reading-feature {
        grid-template-columns: minmax(0, 1fr);
      }
      .reading-resources--minimal .reading-live-books .reading-copy {
        grid-column: 1;
      }
      .reading-resources--minimal .reading-live-books .reading-actions {
        grid-column: 1;
      }
      .reading-editions-grid {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto;
      }
      .reading-book {
        grid-template-columns: minmax(0, min(4.5rem, 20%)) minmax(0, 1fr);
        grid-template-rows: auto auto auto;
        grid-row: auto;
        gap: var(--space-2) var(--space-4);
        padding: var(--space-4);
      }
      .reading-book-cover {
        grid-column: 1;
        grid-row: 1 / span 3;
        height: 6rem;
        padding: 0;
        align-self: start;
      }
      .reading-book > :not(.reading-book-cover) {
        grid-column: 2;
        margin: 0;
      }
      .reading-book a {
        justify-self: start;
        align-self: start;
      }
      .reading-feature {
        padding: var(--space-5);
        gap: var(--space-3);
      }
      .reading-cover {
        padding: var(--space-3);
      }
      .reading-resources--split .reading-feature {
        grid-template-columns: minmax(0, 1fr);
      }
      .reading-resources--split .reading-cover {
        padding: var(--space-2);
      }
      .reading-resources--split .reading-cover img {
        height: 8rem;
      }
    }
  }
</style>
