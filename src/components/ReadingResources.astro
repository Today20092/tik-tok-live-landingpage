---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import cover from '../assets/books/riyad-as-salihin.webp';
import clearCover from '../assets/books/clear-quran-generated.png';
import projectCover from '../assets/books/quran-project-generated.png';
import haleemCover from '../assets/books/abdel-haleem-paperback-generated.png';
import parallelCover from '../assets/books/abdel-haleem-hardcover-generated.png';
interface Props { layout?: 'note' | 'split' | 'minimal' }
const { layout = 'split' } = Astro.props;
const links = (await getCollection('links')).map(({ data }) => data);
function resource(icon: string) {
  const link = links.find((item) => item.icon === icon);
  if (!link) throw new Error(`Missing reading resource: ${icon}`);
  return link.url;
}
const groups = [
  { title: 'Free printed Qurans', books: [
    { title: 'The Clear Quran', image: clearCover, note: 'Non-Muslims in the USA. One free copy per order.', label: 'Request a copy', url: resource('Mail') },
    { title: 'The Quran Project', image: projectCover, note: 'Free for non-Muslims. Check delivery eligibility and postage.', label: 'Check eligibility', url: resource('PackageOpen') },
  ] },
  { title: 'Earlier readings & other editions', books: [
    { title: 'The Clear Quran', image: clearCover, note: 'English + Arabic. My earlier live edition; spiral binding was added locally.', label: 'View print edition', url: resource('Book') },
    { title: 'The Quran · Abdel Haleem', image: haleemCover, note: 'English paperback. The translation I normally quote in articles.', label: 'View paperback', url: 'https://amzn.to/4dxs7C8' },
    { title: 'The Quran · Parallel text', image: parallelCover, note: 'Arabic + English hardcover. Translated by M. A. S. Abdel Haleem.', label: 'View hardcover', url: 'https://amzn.to/4xS97GV' },
  ] },
];
---

<section id="books" class:list={['reading-resources', `reading-resources--${layout}`]} aria-labelledby="reading-title">
  <div class="reading-feature">
    <div class="reading-cover"><Image src={cover} alt="Red cover of Riyad as-Salihin" width={240} loading="eager" /></div>
    <div class="reading-copy">
      <p class="reading-label">Reading on TikTok Live</p>
      <h1 id="reading-title">Meadows of the Righteous</h1>
      <p class="reading-subtitle">Riyad as-Salihin · Imam an-Nawawi</p>
      <p>Hadith and Quran passages on faith, character, and everyday life.</p>
      <div class="reading-actions">
        <a class="control control-primary" href={resource('Scroll')}>Download free PDF ↗</a>
        <a class="control control-outline" href="https://turath.co.uk/products/riyad-as-salihin-abridged-and-annotated">My print edition ↗</a>
      </div>
    </div>
  </div>
  <div id="copies" class="reading-links">
    <a href={resource('BookOpen')}>Read the Quran online <span aria-hidden="true">↗</span></a>
    <p>Free English translation and audio on Quran.com.</p>
    {groups.map((group, i) => <details>
      <summary>{group.title}</summary>
      <div class="reading-expanded">
        <reading-shelf>
        <div class:list={['reading-carousel', { 'reading-carousel-pair': i === 0 }]} tabindex="0" role="region" aria-label={group.title}>
          {group.books.map((book) => <article class="reading-book">
            <div class="reading-book-cover"><Image src={book.image} alt={`${book.title} cover illustration`} width={400} loading="lazy" /></div>
            <h3>{book.title}</h3>
            <p>{book.note}</p>
            <a class="control control-outline" href={book.url} rel={book.url.includes('amzn.to') ? 'sponsored' : undefined}>{book.label} ↗</a>
          </article>)}
        </div>
        </reading-shelf>
        {i === 1 && <p class="reading-caption">Paid editions. Amazon links are affiliate links; I earn from qualifying purchases.</p>}
      </div>
    </details>)}
  </div>
</section>

<script>
  class ReadingShelf extends HTMLElement {
    connectedCallback() {
      const carousel = this.querySelector<HTMLElement>('.reading-carousel');
      if (!carousel) return;
      const update = () => {
        const inset = parseFloat(getComputedStyle(carousel).paddingInlineStart) + 1;
        this.toggleAttribute('data-more-left', carousel.scrollLeft > inset);
        this.toggleAttribute('data-more-right', carousel.scrollWidth - carousel.clientWidth - carousel.scrollLeft > inset);
      };
      carousel.addEventListener('scroll', update, { passive: true });
      const revealFocusedCard = (event: FocusEvent) => {
        if (event.target instanceof Element) event.target.closest('.reading-book')?.scrollIntoView({ block: 'nearest', inline: 'start', behavior: 'instant' });
      };
      carousel.addEventListener('focusin', revealFocusedCard);
      const observer = new ResizeObserver(update);
      observer.observe(carousel);
      this.cleanup = () => {
        carousel.removeEventListener('scroll', update);
        carousel.removeEventListener('focusin', revealFocusedCard);
        observer.disconnect();
      };
      update();
    }
    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('reading-shelf')) customElements.define('reading-shelf', ReadingShelf);
</script>

<style>
  @layer components {
    .reading-resources { margin-block: 0 var(--space-8); }
    .reading-feature { display: grid; gap: var(--space-5); padding: var(--space-6); background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-main); }
    .reading-cover { display: grid; place-items: center; padding: var(--space-5); }
    .reading-cover img { width: auto; height: 8rem; max-width: 100%; object-fit: contain; filter: drop-shadow(3px 5px 4px color-mix(in srgb, var(--foreground) 14%, transparent)); }
    .reading-copy { display: grid; gap: var(--space-2); min-width: 0; align-content: center; }
    .reading-copy > *, .reading-links p { margin: 0; }
    .reading-copy h1 { font-family: var(--font-serif); font-size: var(--text-3xl); line-height: var(--leading-tight); text-wrap: balance; }
    .reading-label { color: var(--primary); font-size: var(--text-small); font-weight: 600; }
    .reading-subtitle, .reading-caption { color: var(--muted-foreground); font-size: var(--text-small); }
    .reading-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); padding-top: var(--space-2); }
    .reading-actions a { min-height: var(--control-height); display: inline-flex; align-items: center; white-space: normal; }
    .reading-actions a:not(.control), .reading-expanded a { text-decoration: underline; text-underline-offset: .2em; }
    .reading-links { margin-top: var(--space-6); }
    .reading-links > a { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); min-height: var(--control-height); font-weight: 600; }
    .reading-links > p { color: var(--muted-foreground); margin-bottom: var(--space-4); }
    .reading-links details { border-top: 1px solid var(--border); }
    .reading-links summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); min-height: var(--control-height); padding-block: var(--space-3); cursor: pointer; }
    .reading-links summary::after { content: '+'; flex-shrink: 0; }
    .reading-links details[open] summary::after { content: '−'; }
    .reading-expanded { display: grid; gap: var(--space-4); padding-block: var(--space-2) var(--space-5); color: var(--muted-foreground); }
    .reading-expanded a { color: var(--foreground); }
    reading-shelf { display: block; position: relative; min-width: 0; }
    reading-shelf::before, reading-shelf::after { content: ''; position: absolute; z-index: 1; top: 0; bottom: var(--space-4); width: var(--space-8); pointer-events: none; opacity: 0; }
    reading-shelf::before { left: 0; background: linear-gradient(to right, var(--background), transparent); }
    reading-shelf::after { right: 0; background: linear-gradient(to left, var(--background), transparent); }
    reading-shelf[data-more-left]::before, reading-shelf[data-more-right]::after { opacity: 1; }
    .reading-carousel { display: grid; grid-auto-flow: column; grid-template-columns: repeat(3, minmax(16rem, var(--book-width, 44%))); grid-template-rows: 14rem auto 1fr auto; gap: var(--space-3) var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; padding: var(--space-2) var(--space-2) var(--space-4); scrollbar-color: var(--border) transparent; }
    .reading-carousel-pair { grid-template-columns: repeat(2, minmax(16rem, var(--book-width, 44%))); }
    .reading-carousel { scroll-padding-inline: var(--space-2); }
    .reading-book { scroll-snap-stop: always; }
    .reading-carousel:focus-visible { outline: 3px solid var(--ring); outline-offset: 3px; }
    .reading-book { display: grid; grid-template-rows: subgrid; grid-row: span 4; min-width: 0; scroll-snap-align: start; color: var(--foreground); background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-main); overflow: hidden; }
    .reading-book > :not(.reading-book-cover) { margin-inline: var(--space-4); }
    .reading-book-cover { display: grid; place-items: center; padding: var(--space-4); min-height: 0; }
    .reading-book-cover img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; }
    .reading-book h3 { font-size: var(--text-lg); line-height: var(--leading-tight); }
    .reading-book p { font-size: var(--text-small); color: var(--muted-foreground); }
    .reading-book a { margin-block: var(--space-2) var(--space-4); white-space: normal; text-decoration: none; align-self: stretch; }
    .reading-resources--split .reading-feature { grid-template-columns: minmax(8rem, 1fr) minmax(0, 2fr); background: transparent; border: 0; padding: 0; }
    .reading-resources--split .reading-cover { background: var(--secondary); border-radius: var(--radius-main); }
    .reading-resources--split .reading-cover img { height: 11rem; }
    .reading-resources--minimal .reading-feature { border: 0; border-block: 1px solid var(--border); background: transparent; border-radius: 0; padding-inline: 0; }
    .reading-resources--minimal .reading-cover { display: none; }
    .reading-resources--minimal .reading-actions .control { background: transparent; color: var(--primary); padding-inline: 0; text-decoration: underline; text-underline-offset: .2em; }
    @media (width < 40rem) {
      .reading-carousel { --book-width: 82%; }
      .reading-feature { padding: var(--space-5); gap: var(--space-3); }
      .reading-cover { padding: var(--space-3); }
      .reading-resources--split .reading-feature { grid-template-columns: minmax(0, 1fr); }
      .reading-resources--split .reading-cover { padding: var(--space-6); }
      .reading-resources--split .reading-cover img { height: 8rem; }
    }
  }
</style>
