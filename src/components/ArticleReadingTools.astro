---
import { buttonVariants } from '@/components/ui/button';
import { IconArrowUp, IconList, IconX } from '@tabler/icons-react';
---

<progress
  id="reading-progress"
  aria-label="Approximate article reading position"
  max="100"
  value="0"
  data-pagefind-ignore
  hidden
  class="reading-progress"
></progress>
<nav
  class="reading-navigation"
  aria-label="Article navigation"
  data-pagefind-ignore
  hidden
>
  <button
    id="show-contents"
    type="button"
    aria-haspopup="dialog"
    class="control control-outline"
    hidden
  >
    <IconList size={18} aria-hidden="true" /> Contents
  </button>
  <a
    id="back-to-top"
    href="#article-top"
    data-pagefind-ignore
    hidden
    class={buttonVariants({
      variant: 'outline',
      size: 'lg',
      className: 'reading-back-to-top',
    })}
  >
    <IconArrowUp data-icon="inline-start" aria-hidden="true" />
    Back to top
  </a>
</nav>
<dialog
  id="contents-sheet"
  aria-labelledby="contents-sheet-title"
  closedby="any"
  data-pagefind-ignore
  class="dialog_content contents-sheet"
>
  <div class="contents-sheet_header">
    <h2 id="contents-sheet-title" class="dialog_dialogprimitive-title">
      On this page
    </h2>
    <form method="dialog">
      <button
        aria-label="Close contents"
        class={buttonVariants({ variant: 'outline', size: 'icon' })}
      >
        <IconX aria-hidden="true" />
      </button>
    </form>
  </div>
  <nav aria-labelledby="contents-sheet-title"></nav>
</dialog>

<script>
  const article = document.getElementById('article-body');
  const title = document.getElementById('article-top');
  const progress =
    document.querySelector<HTMLProgressElement>('#reading-progress');
  const backToTop = document.getElementById('back-to-top');
  const showContents = document.getElementById('show-contents');
  const page = article?.closest<HTMLElement>('.article-page--reader');
  const shell = page?.closest<HTMLElement>('.site-shell--article');
  const siteHeader = shell?.querySelector<HTMLElement>('[data-site-header]');
  const contents = page?.querySelector<HTMLDetailsElement>(
    '.article-page_contents'
  );
  const links = [
    ...(contents?.querySelectorAll<HTMLAnchorElement>('[data-contents-link]') ??
      []),
  ];
  const headings = links.map((link) =>
    document.getElementById(decodeURIComponent(link.hash.slice(1)))
  );
  const sheet = document.querySelector<HTMLDialogElement>('#contents-sheet');
  // Clone the rendered contents so the sheet never needs its own list.
  const sheetList = contents
    ?.querySelector('.article-page_contents-list')
    ?.cloneNode(true);
  if (sheet && sheetList) sheet.querySelector('nav')?.append(sheetList);
  const sheetLinks = [
    ...(sheet?.querySelectorAll<HTMLAnchorElement>('[data-contents-link]') ??
      []),
  ];
  const rail = contents?.querySelector<HTMLElement>(
    '.article-page_contents-track > span'
  );

  if (article && title && progress && backToTop) {
    const end = document.getElementById('article-resources') ?? article;
    let pending = false;
    let desktop = false;
    let mobileOpen = contents?.open ?? false;
    const update = () => {
      pending = false;
      const rootSize = parseFloat(
        getComputedStyle(document.documentElement).fontSize
      );
      if (shell && siteHeader && page?.parentElement) {
        shell.classList.toggle(
          'has-desktop-reader',
          page.parentElement.getBoundingClientRect().width >= rootSize * 60
        );
        shell.style.setProperty(
          '--article-header-height',
          `${siteHeader.getBoundingClientRect().height}px`
        );
      }
      const nextDesktop = contents
        ? getComputedStyle(contents).position === 'sticky'
        : false;
      if (contents && nextDesktop !== desktop) {
        if (nextDesktop) mobileOpen = contents.open;
        contents.open = nextDesktop || mobileOpen;
        const summary = contents.querySelector('summary');
        if (summary) summary.tabIndex = nextDesktop ? -1 : 0;
        desktop = nextDesktop;
      }
      const bounds = article.getBoundingClientRect();
      const start = bounds.top + window.scrollY;
      const bottom = end.getBoundingClientRect().bottom;
      const distance = bottom - bounds.top - window.innerHeight;
      const fraction =
        distance > 0
          ? Math.min(1, Math.max(0, (window.scrollY - start) / distance))
          : bottom <= window.innerHeight
            ? 1
            : 0;
      progress.hidden = false;
      progress.value = Math.round(fraction * 100);
      if (rail) rail.style.transform = `scaleY(${fraction})`;
      // Use one reading line for both heading clicks and manual scrolling.
      const readingLine = parseFloat(
        getComputedStyle(title).scrollMarginBlockStart
      );
      let active = -1;
      headings.forEach((heading, index) => {
        if (
          heading &&
          heading.getClientRects().length &&
          heading.getBoundingClientRect().top <= readingLine + 1
        )
          active = index;
      });
      links.forEach((link, index) => {
        for (const item of [link, sheetLinks[index]]) {
          if (index === active) item?.setAttribute('aria-current', 'location');
          else item?.removeAttribute('aria-current');
        }
      });
      const currentSection = links[active]?.closest('[data-contents-section]');
      contents
        ?.querySelectorAll('[data-contents-section]')
        .forEach((section) => {
          section.classList.toggle('is-active', section === currentSection);
        });
      page?.classList.add('has-reading-tools');
      progress.classList.toggle('reading-progress--rail', desktop);
      backToTop.hidden = window.scrollY < window.innerHeight * 2;
      backToTop.closest<HTMLElement>('.reading-navigation')!.hidden =
        backToTop.hidden;
      if (showContents)
        showContents.hidden = desktop || !contents || backToTop.hidden;
    };
    const scheduleUpdate = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    contents?.addEventListener('focusout', scheduleUpdate);
    new ResizeObserver(scheduleUpdate).observe(document.body);
    if (siteHeader) new ResizeObserver(scheduleUpdate).observe(siteHeader);
    backToTop.addEventListener('click', (event) => {
      event.preventDefault();
      title.focus({ preventScroll: true });
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'instant'
          : 'smooth',
      });
    });
    showContents?.addEventListener('click', () => sheet?.showModal());
    sheet?.addEventListener('click', (event) => {
      // Close, then let the browser follow the fragment like the in-page list.
      if ((event.target as Element).closest('a')) return sheet.close('link');
      // shortcut: backdrop-click fallback for browsers without closedby; drop once Safari ships it.
      if ('closedBy' in HTMLDialogElement.prototype || event.target !== sheet)
        return;
      const rect = sheet.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        sheet.close();
    });
    sheet?.addEventListener('close', () => {
      // Safari does not focus a tapped button, so native focus return can miss it.
      if (sheet.returnValue !== 'link')
        showContents?.focus({ preventScroll: true });
      sheet.returnValue = '';
    });
    update();
  }
</script>
