---
import type { CollectionEntry } from 'astro:content';
interface Props {
  articles: CollectionEntry<'articles'>[];
  heading?: 'h2' | 'h3';
}
const { articles, heading: Heading = 'h2' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ol class="list-none divide-y divide-border">
  {articles.map((article) => (
    <li class="py-5 first:pt-0">
      <article class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-6">
        <time
          datetime={article.data.date.toISOString().slice(0, 10)}
          class="text-xs text-muted-foreground sm:pt-1"
        >
          {article.data.date.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
        <div>
          <Heading class="text-2xl font-semibold leading-snug tracking-tight text-foreground sm:text-3xl">
            <a
              href={`${base}articles/${article.id}/`}
              class="rounded-sm decoration-primary/40 underline-offset-4 hover:text-primary hover:underline"
            >
              {article.data.title}
            </a>
          </Heading>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
            {article.data.description}
          </p>
        </div>
      </article>
    </li>
  ))}
</ol>
