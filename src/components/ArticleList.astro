---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '@/lib/reading-time';
import LumosHeading from './lumos/Heading.astro';
interface Props {
  articles: CollectionEntry<'articles'>[];
  heading?: 'h2' | 'h3';
}
const { articles, heading: Heading = 'h2' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ol class="article-list">
  {articles.map((article) => (
    <li class="group article-list_item">
      <article class="article-list_entry">
        <time
          datetime={article.data.date.toISOString().slice(0, 10)}
          class="article-list_date"
        >
          {article.data.date.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
        <div>
          <LumosHeading tag={Heading} variant="h2" class="article-list_heading">
            <a
              href={`${base}articles/${article.id}/`}
              class="article-list_link"
            >
              {article.data.title}
            </a>
          </LumosHeading>
          <p class="article-list_description">{article.data.description}</p>
          <p class="article-list_reading-time">
            About {readingTime(article.body)} min read
          </p>
        </div>
      </article>
    </li>
  ))}
</ol>
