---
import { Image } from 'astro:assets';
import courtyard from '../assets/courtyard.webp';
import {
  ArrowUpRight,
  ArrowRight,
  BookOpen,
  Play,
  PackageOpen,
  ChevronDown,
  Heart,
  Compass,
} from 'lucide-react';
import { getCollection } from 'astro:content';
interface Props {
  variant?: 'flow' | 'pocket' | 'journal' | 'focus';
}
const { variant = 'flow' } = Astro.props;
const links = (await getCollection('links')).map((entry) => entry.data);
const copies = links.filter(
  (link) => link.variant === 'featured' && link.icon !== 'BookOpen'
);
const book = links.find((link) => link.variant === 'stream-pick');
const videos = links.filter((link) => link.youtube);
const resources = links.filter((link) => !link.variant && !link.youtube);
const support = links.find((link) => link.variant === 'support');
const youtube = 'https://go.alphabravomedia.co/islam-youtube';
const base = import.meta.env.BASE_URL;
const pocket = variant === 'pocket';
const journal = variant === 'journal';
const focus = variant === 'focus';
const variants = ['flow', 'pocket', 'journal', 'focus'];
const Section = focus ? 'details' : 'section';
const sectionClass = 'group scroll-mt-24 border-t border-current/15 py-7';
const titleClass = journal
  ? 'font-serif text-3xl leading-tight'
  : 'text-xl font-semibold tracking-tight';
const action =
  'inline-flex min-h-12 items-center justify-center gap-3 rounded-full px-6 py-3 text-sm font-semibold transition-transform hover:-translate-y-0.5 active:scale-[0.98] motion-reduce:transform-none';
const shortNames: Record<string, string> = {
  PencilLine: 'Session drawing board',
};
---

<div
  data-design={variant}
  class:list={[
    'min-h-dvh font-sans',
    focus
      ? 'bg-[#14271f] text-[#f1f5ed]'
      : journal
        ? 'bg-[#f8f5ed] text-[#303a32]'
        : 'bg-[#f7f9f5] text-[#243a30]',
  ]}
>
  <a
    href="#read"
    class="fixed top-3 left-3 z-50 -translate-y-24 rounded-full bg-white px-5 py-3 text-stone-900 focus:translate-y-0"
  >
    Skip to resources
  </a>
  <nav
    aria-label="Compare layouts"
    class="sticky top-0 z-40 border-b border-current/10 bg-inherit px-4"
  >
    <div class="mx-auto flex max-w-3xl items-center gap-3">
      <span class="hidden text-xs opacity-70 sm:block">Try a layout</span>
      <div class="grid flex-1 grid-cols-4">
        {variants.map((name) => (
          <a
            href={name === 'flow' ? base : `${base}${name}/`}
            aria-current={variant === name ? 'page' : undefined}
            class:list={[
              'min-h-12 border-b-2 px-2 py-4 text-center text-xs font-semibold capitalize transition-colors hover:bg-current/5',
              variant === name
                ? 'border-current'
                : 'border-transparent opacity-80',
            ]}
          >
            {name}
          </a>
        ))}
      </div>
    </div>
  </nav>
  <div
    class:list={[
      'mx-auto px-6 pb-10 sm:px-10',
      journal ? 'max-w-4xl' : 'max-w-2xl',
    ]}
  >
    <header class="flex h-20 items-center justify-between gap-4 text-sm">
      <a href={base} class="inline-flex items-center gap-2 font-semibold">
        <BookOpen size={20} strokeWidth={1.5} />
        Ayoub
      </a>
      <a
        href="https://go.alphabravomedia.co/islam-tiktok"
        class="inline-flex min-h-11 items-center gap-1 text-xs"
      >
        Find me on TikTok <ArrowUpRight size={14} />
      </a>
    </header>
    <main>
      {variant === 'flow' && (
        <section id="read" class="scroll-mt-24 pb-9 pt-5">
          <p class="mb-4 text-sm text-muted-foreground">
            From the live, for your own time.
          </p>
          <h1 class="max-w-lg text-4xl font-medium leading-[1.12] tracking-tight sm:text-5xl">
            A little space
            <br />
            to learn.
          </h1>
          <p class="mt-5 max-w-sm text-base leading-relaxed text-muted-foreground">
            Read the Quran in English, find a copy, and keep exploring with
            Ayoub.
          </p>
          <a
            href="https://go.alphabravomedia.co/islam-quran"
            class={`${action} mt-7 bg-[#254f39] text-white`}
          >
            Read Quran <ArrowUpRight size={18} />
          </a>
          <p class="mt-3 text-xs text-muted-foreground">
            Free on Quran.com. Translation & audio.
          </p>
          <nav aria-label="Quick actions" class="mt-8 grid gap-1">
            <a
              href="#copies"
              class="flex min-h-14 items-center justify-between text-lg"
            >
              Find your copy <ArrowRight size={20} strokeWidth={1.5} />
            </a>
            <a
              href={youtube}
              class="flex min-h-14 items-center justify-between text-lg"
            >
              Catch up on the live <ArrowUpRight size={20} strokeWidth={1.5} />
            </a>
          </nav>
        </section>
      )}
      {journal && (
        <section id="read" class="scroll-mt-24 pb-10 pt-3">
          <div class="flex items-center gap-6">
            <div class="min-w-0 flex-1">
              <p class="text-xs font-medium uppercase tracking-widest">
                Reading with Ayoub
              </p>
              <h1 class="mt-4 font-serif text-4xl leading-[1.08] tracking-tight sm:text-6xl">
                Begin with
                <br />
                the Quran.
              </h1>
            </div>
            <Image
              src={courtyard}
              width={576}
              loading="eager"
              alt=""
              fetchpriority="high"
              class="h-36 w-20 shrink-0 rounded-t-full object-cover sm:h-48 sm:w-32"
            />
          </div>
          <p class="mt-5 max-w-md text-base leading-relaxed opacity-75">
            An English translation. A book to keep. Something to return to after
            the live.
          </p>
          <a
            href="https://go.alphabravomedia.co/islam-quran"
            class="mt-6 inline-flex min-h-12 items-center gap-5 border-b border-current pb-1 text-lg font-medium"
          >
            Read Quran online <ArrowUpRight size={20} />
          </a>
        </section>
      )}
      {focus && (
        <section
          id="read"
          class="relative -mx-6 isolate scroll-mt-24 overflow-hidden px-6 py-10 sm:mx-0 sm:rounded-t-full sm:px-10 sm:pt-20"
        >
          <Image
            src={courtyard}
            widths={[480, 960, 1536]}
            sizes="(min-width: 1024px) 960px, 100vw"
            loading="eager"
            alt=""
            fetchpriority="high"
            class="absolute inset-0 -z-20 h-full w-full object-cover"
          />
          <div class="absolute inset-0 -z-10 bg-[#10231c]/85"></div>
          <p class="text-sm text-[#d4e4cf]">
            Quran resources from Ayoub's live
          </p>
          <h1 class="mt-5 max-w-md text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl">
            Make time
            <br />
            for the Quran.
          </h1>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-[#d4e4cf]">
            Read in English, listen, and understand.
          </p>
          <a
            href="https://go.alphabravomedia.co/islam-quran"
            class={`${action} mt-7 bg-[#e3eed8] text-[#14271f]`}
          >
            Start reading <ArrowUpRight size={18} />
          </a>
          <a
            href={youtube}
            class="mt-5 flex min-h-11 items-center gap-2 text-sm"
          >
            Watch Ayoub's recordings <ArrowUpRight size={16} />
          </a>
        </section>
      )}
      {pocket && (
        <>
          <section class="pb-6 pt-4">
            <h1 class="text-3xl font-semibold leading-tight tracking-tight">
              What brings
              <br />
              you here?
            </h1>
            <p class="mt-3 text-sm text-muted-foreground">
              Quran resources, one thing at a time.
            </p>
          </section>
          <nav data-task-tabs hidden aria-label="Choose a task" class="mb-8">
            <div
              role="tablist"
              aria-label="Resources"
              class="flex justify-between gap-2"
            >
              {[
                { id: 'read', label: 'Read', Icon: BookOpen },
                { id: 'copies', label: 'Get a copy', Icon: PackageOpen },
                { id: 'watch', label: 'Watch', Icon: Play },
                { id: 'more', label: 'Explore', Icon: Compass },
              ].map(({ id, label, Icon }) => (
                <button
                  type="button"
                  id={`tab-${id}`}
                  role="tab"
                  aria-controls={id}
                  aria-selected={id === 'read'}
                  tabindex={id === 'read' ? 0 : -1}
                  data-task={id}
                  class="grid min-h-20 flex-1 justify-items-center gap-2 rounded-2xl px-1 py-3 text-xs transition-colors aria-selected:bg-[#e1eadc] aria-selected:font-semibold hover:bg-[#ecf0e8]"
                >
                  <Icon size={23} strokeWidth={1.5} />
                  {label}
                </button>
              ))}
            </div>
          </nav>
          <section id="read" data-panel class="pb-8 pt-2">
            <div class="flex items-center justify-between gap-4">
              <div>
                <h2 class="text-2xl font-semibold leading-tight">
                  Read. Listen.
                  <br />
                  Take your time.
                </h2>
                <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                  English translation, recitation,
                  <br />
                  and explanations on Quran.com.
                </p>
              </div>
              <Image
                src={courtyard}
                width={480}
                alt=""
                loading="lazy"
                class="h-40 w-24 shrink-0 rounded-full object-cover"
              />
            </div>
            <a
              href="https://go.alphabravomedia.co/islam-quran"
              class={`${action} mt-8 w-full bg-[#254f39] text-white`}
            >
              Open Quran.com <ArrowUpRight size={18} />
            </a>
            <p class="mt-4 text-center text-xs text-muted-foreground">
              Free to read. No account needed to begin.
            </p>
          </section>
        </>
      )}
      <div
        class:list={[journal && 'sm:grid sm:grid-cols-[1fr_0.8fr] sm:gap-x-12']}
      >
        <Section id="copies" data-panel class={sectionClass}>
          {focus ? (
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <span class={titleClass}>Find a copy to keep</span>
              <ChevronDown
                size={20}
                className="transition-transform group-open:rotate-180"
              />
            </summary>
          ) : (
            <h2 class={titleClass}>
              {journal ? 'A book of your own' : 'Find your copy'}
            </h2>
          )}
          <div class="mt-5 grid gap-8">
            {copies.map((link) => (
              <article class={journal ? 'border-l border-current/25 pl-5' : ''}>
                {focus ? (
                  <h2 class="text-base font-semibold">
                    {link.icon === 'Mail'
                      ? 'The Clear Quran'
                      : 'The Quran Project'}
                  </h2>
                ) : (
                  <h3 class="text-base font-semibold">
                    {link.icon === 'Mail'
                      ? 'The Clear Quran'
                      : 'The Quran Project'}
                  </h3>
                )}
                <p class="mt-1 text-xs font-medium opacity-80">
                  Free for non-Muslims
                </p>
                <p class="mt-3 max-w-sm text-sm leading-relaxed opacity-75">
                  {link.icon === 'Mail'
                    ? 'USA only. One English copy from One Message Foundation.'
                    : 'English translation with chapter introductions. Check delivery eligibility with the provider.'}
                </p>
                <a
                  href={link.url}
                  class="mt-3 inline-flex min-h-11 items-center gap-3 text-sm font-semibold underline decoration-current/30 underline-offset-8 hover:decoration-current"
                >
                  {link.icon === 'Mail'
                    ? 'Request The Clear Quran'
                    : 'Request The Quran Project'}{' '}
                  <ArrowUpRight size={16} />
                </a>
              </article>
            ))}
          </div>
          {book && (
            <details class="group/book mt-6 border-t border-current/15 pt-2">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium">
                The book Ayoub uses{' '}
                <ChevronDown size={17} className="group-open/book:rotate-180" />
              </summary>
              <p class="max-w-sm text-sm leading-relaxed opacity-75">
                The Clear Quran, English + Arabic. Paid paperback; Ayoub's
                spiral binding was done locally.
              </p>
              <a
                href={book.url}
                class="mt-3 inline-flex min-h-12 items-center gap-2 text-sm font-semibold underline underline-offset-4"
              >
                View at Furqaan Bookstore <ArrowUpRight size={16} />
              </a>
            </details>
          )}
        </Section>
        <Section id="watch" data-panel class={sectionClass}>
          {focus ? (
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <span class={titleClass}>Watch & keep learning</span>
              <ChevronDown size={20} className="group-open:rotate-180" />
            </summary>
          ) : (
            <h2 class={titleClass}>
              {journal ? 'Watch & reflect' : 'Watch and learn'}
            </h2>
          )}
          <a
            href={youtube}
            class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold underline underline-offset-4"
          >
            Ayoub's recordings <ArrowUpRight size={16} />
          </a>
          <div class="mt-5 grid gap-6">
            {videos.map((link) => {
              const thumbnail = link.youtube?.includes('PLlZaz')
                ? 'sQMC7fkjmOA'
                : link.youtube?.includes('PL9821')
                  ? 'IQjzErJlpJ0'
                  : link.youtube;
              return (
                <a
                  href={link.url}
                  class:list={[
                    'group/video',
                    journal ? 'block' : 'flex items-center gap-4',
                  ]}
                >
                  <span
                    class:list={[
                      'block overflow-hidden',
                      journal
                        ? 'mb-3 aspect-video w-full'
                        : 'aspect-square w-20 shrink-0 rounded-full',
                    ]}
                  >
                    <Image
                      src={`https://i.ytimg.com/vi/${thumbnail}/hqdefault.jpg`}
                      width={480}
                      height={360}
                      widths={[160, 320, 480]}
                      quality={70}
                      sizes={
                        journal ? '(min-width: 1024px) 480px, 90vw' : '80px'
                      }
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover/video:scale-105 motion-reduce:transform-none"
                    />
                  </span>
                  <span class="block min-w-0">
                    <span class="block text-sm font-medium leading-snug">
                      {link.title.replaceAll('—', '-')}
                    </span>
                    <span class="mt-2 inline-flex min-h-6 items-center gap-1 text-xs opacity-75">
                      {link.youtube?.startsWith('videoseries')
                        ? 'Watch playlist'
                        : 'Watch video'}{' '}
                      <ArrowUpRight size={14} />
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
        </Section>
        <Section
          id="more"
          data-panel
          class:list={[sectionClass, journal && 'sm:col-span-2']}
        >
          {focus ? (
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <span class={titleClass}>Explore a little further</span>
              <ChevronDown size={20} className="group-open:rotate-180" />
            </summary>
          ) : (
            <h2 class={titleClass}>More from the live</h2>
          )}
          <div class="mt-3">
            {resources.map((link) => (
              <a
                href={link.url}
                class="flex min-h-16 items-center justify-between gap-4 text-sm hover:underline"
              >
                {shortNames[link.icon] ?? link.title}
                <ArrowUpRight size={18} />
              </a>
            ))}
          </div>
        </Section>
      </div>
    </main>
    <footer class="mt-6 border-t border-current/15 pt-5 text-xs">
      {support && (
        <a
          href={support.url}
          class="inline-flex min-h-12 items-center gap-2 text-sm"
        >
          <Heart size={16} />
          Support the live on Ko-fi <ArrowUpRight size={14} />
        </a>
      )}
      <nav aria-label="Social profiles" class="mt-3 flex gap-5">
        <a href="https://go.alphabravomedia.co/islam-tiktok" class="py-3">
          TikTok
        </a>
        <a href="https://go.alphabravomedia.co/islam-twitch" class="py-3">
          Twitch
        </a>
        <a href={youtube} class="py-3">
          YouTube
        </a>
      </nav>
      <details class="mt-2 opacity-75">
        <summary class="cursor-pointer py-3">About & privacy</summary>
        <p class="max-w-md pb-4 leading-relaxed">
          Quran reading resources shared by Ayoub. Contact him through his
          profiles above. No forms, accounts, or sign-ins on this page. External
          services have their own privacy policies.
        </p>
      </details>
    </footer>
  </div>
</div>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-task]')
  );
  if (tabs.length) {
    const nav = document.querySelector<HTMLElement>('[data-task-tabs]');
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-panel]')
    );
    const activate = (id: string, moveFocus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.task === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.id !== id;
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', `tab-${panel.id}`);
        panel.tabIndex = 0;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.task!));
      tab.addEventListener('keydown', (event) => {
        let target: number;
        if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft')
          target = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[target].dataset.task!, true);
      });
    });
    activate('read');
    if (nav) nav.hidden = false;
  }
</script>
