---
import { Image } from 'astro:assets';
import courtyard from '../assets/courtyard.webp';
import {
  ArrowUpRight,
  ArrowRight,
  BookOpen,
  Play,
  PackageOpen,
  ChevronDown,
  Heart,
  Compass,
} from 'lucide-react';
import { getCollection } from 'astro:content';
interface Props {
  variant?: 'flow' | 'pocket' | 'journal' | 'focus';
}
const { variant = 'flow' } = Astro.props;
const links = (await getCollection('links')).map((entry) => entry.data);
const copies = links.filter(
  (link) => link.variant === 'featured' && link.icon !== 'BookOpen'
);
const book = links.find((link) => link.variant === 'stream-pick');
const videos = links.filter((link) => link.youtube);
const resources = links.filter((link) => !link.variant && !link.youtube);
const support = links.find((link) => link.variant === 'support');
const youtube = 'https://go.alphabravomedia.co/islam-youtube';
const base = import.meta.env.BASE_URL;
const pocket = variant === 'pocket';
const journal = variant === 'journal';
const focus = variant === 'focus';
const variants = ['flow', 'pocket', 'journal', 'focus'];
const Section = focus ? 'details' : 'section';
const sectionClass = 'group variant-hub_sectionclass';
const titleClass = journal
  ? 'variant-hub_titleclass'
  : 'variant-hub_titleclass-2';
const action = 'variant-hub_action';
const shortNames: Record<string, string> = {
  PencilLine: 'Session drawing board',
};
---

<div
  data-design={variant}
  class:list={[
    'variant-hub_div',
    focus
      ? 'variant-hub_div-2'
      : journal
        ? 'variant-hub_div-3'
        : 'variant-hub_div-4',
  ]}
>
  <a href="#read" class="variant-hub_a">
    Skip to resources
  </a>
  <nav aria-label="Compare layouts" class="variant-hub_nav">
    <div class="variant-hub_div-5">
      <span class="variant-hub_span">Try a layout</span>
      <div class="variant-hub_div-6">
        {variants.map((name) => (
          <a
            href={name === 'flow' ? base : `${base}${name}/`}
            aria-current={variant === name ? 'page' : undefined}
            class:list={[
              'variant-hub_a-2',
              variant === name ? 'u-border-current' : 'variant-hub_a-3',
            ]}
          >
            {name}
          </a>
        ))}
      </div>
    </div>
  </nav>
  <div
    class:list={['variant-hub_div-7', journal ? 'u-max-w-4xl' : 'u-max-w-2xl']}
  >
    <header class="variant-hub_header">
      <a href={base} class="variant-hub_a-4">
        <BookOpen size={20} strokeWidth={1.5} />
        Ayoub
      </a>
      <a
        href="https://go.alphabravomedia.co/islam-tiktok"
        class="variant-hub_a-5"
      >
        Find me on TikTok <ArrowUpRight size={14} />
      </a>
    </header>
    <main>
      {variant === 'flow' && (
        <section id="read" class="variant-hub_read">
          <p class="variant-hub_p">From the live, for your own time.</p>
          <h1 class="variant-hub_h1">
            A little space
            <br />
            to learn.
          </h1>
          <p class="variant-hub_p-2">
            Read the Quran in English, find a copy, and keep exploring with
            Ayoub.
          </p>
          <a
            href="https://go.alphabravomedia.co/islam-quran"
            class={`${action} variant-hub_a-6`}
          >
            Read Quran <ArrowUpRight size={18} />
          </a>
          <p class="variant-hub_p-3">Free on Quran.com. Translation & audio.</p>
          <nav aria-label="Quick actions" class="variant-hub_nav-2">
            <a href="#copies" class="variant-hub_a-7">
              Find your copy <ArrowRight size={20} strokeWidth={1.5} />
            </a>
            <a href={youtube} class="variant-hub_a-7">
              Catch up on the live <ArrowUpRight size={20} strokeWidth={1.5} />
            </a>
          </nav>
        </section>
      )}
      {journal && (
        <section id="read" class="variant-hub_read-2">
          <div class="variant-hub_div-8">
            <div class="variant-hub_div-9">
              <p class="variant-hub_p-4">Reading with Ayoub</p>
              <h1 class="variant-hub_h1-2">
                Begin with
                <br />
                the Quran.
              </h1>
            </div>
            <Image
              src={courtyard}
              width={576}
              loading="eager"
              alt=""
              fetchpriority="high"
              class="variant-hub_image"
            />
          </div>
          <p class="variant-hub_p-5">
            An English translation. A book to keep. Something to return to after
            the live.
          </p>
          <a
            href="https://go.alphabravomedia.co/islam-quran"
            class="variant-hub_a-8"
          >
            Read Quran online <ArrowUpRight size={20} />
          </a>
        </section>
      )}
      {focus && (
        <section id="read" class="variant-hub_read-3 theme-dark">
          <Image
            src={courtyard}
            widths={[480, 960, 1536]}
            sizes="(min-width: 1024px) 960px, 100vw"
            loading="eager"
            alt=""
            fetchpriority="high"
            class="variant-hub_image-2"
          />
          <div class="variant-hub_div-10"></div>
          <p class="variant-hub_p-6">Quran resources from Ayoub's live</p>
          <h1 class="variant-hub_h1-3">
            Make time
            <br />
            for the Quran.
          </h1>
          <p class="variant-hub_p-7">
            Read in English, listen, and understand.
          </p>
          <a
            href="https://go.alphabravomedia.co/islam-quran"
            class={`${action} variant-hub_a-9`}
          >
            Start reading <ArrowUpRight size={18} />
          </a>
          <a href={youtube} class="variant-hub_a-10">
            Watch Ayoub's recordings <ArrowUpRight size={16} />
          </a>
        </section>
      )}
      {pocket && (
        <>
          <section class="variant-hub_section">
            <h1 class="variant-hub_h1-4">
              What brings
              <br />
              you here?
            </h1>
            <p class="variant-hub_p-8">Quran resources, one thing at a time.</p>
          </section>
          <nav data-task-tabs hidden aria-label="Choose a task" class="u-mb-8">
            <div
              role="tablist"
              aria-label="Resources"
              class="variant-hub_div-11"
            >
              {[
                { id: 'read', label: 'Read', Icon: BookOpen },
                { id: 'copies', label: 'Get a copy', Icon: PackageOpen },
                { id: 'watch', label: 'Watch', Icon: Play },
                { id: 'more', label: 'Explore', Icon: Compass },
              ].map(({ id, label, Icon }) => (
                <button
                  type="button"
                  id={`tab-${id}`}
                  role="tab"
                  aria-controls={id}
                  aria-selected={id === 'read'}
                  tabindex={id === 'read' ? 0 : -1}
                  data-task={id}
                  class="variant-hub_button"
                >
                  <Icon size={23} strokeWidth={1.5} />
                  {label}
                </button>
              ))}
            </div>
          </nav>
          <section id="read" data-panel class="variant-hub_read-4">
            <div class="variant-hub_div-12">
              <div>
                <h2 class="variant-hub_h2">
                  Read. Listen.
                  <br />
                  Take your time.
                </h2>
                <p class="variant-hub_p-9">
                  English translation, recitation,
                  <br />
                  and explanations on Quran.com.
                </p>
              </div>
              <Image
                src={courtyard}
                width={480}
                alt=""
                loading="lazy"
                class="variant-hub_image-3"
              />
            </div>
            <a
              href="https://go.alphabravomedia.co/islam-quran"
              class={`${action} variant-hub_a-11`}
            >
              Open Quran.com <ArrowUpRight size={18} />
            </a>
            <p class="variant-hub_p-10">
              Free to read. No account needed to begin.
            </p>
          </section>
        </>
      )}
      <div class:list={[journal && 'variant-hub_div-13']}>
        <Section id="copies" data-panel class={sectionClass}>
          {focus ? (
            <summary class="variant-hub_summary">
              <span class={titleClass}>Find a copy to keep</span>
              <ChevronDown size={20} className="variant-hub_chevrondown" />
            </summary>
          ) : (
            <h2 class={titleClass}>
              {journal ? 'A book of your own' : 'Find your copy'}
            </h2>
          )}
          <div class="variant-hub_div-14">
            {copies.map((link) => (
              <article class={journal ? 'variant-hub_article' : ''}>
                {focus ? (
                  <h2 class="variant-hub_h2-2">
                    {link.icon === 'Mail'
                      ? 'The Clear Quran'
                      : 'The Quran Project'}
                  </h2>
                ) : (
                  <h3 class="variant-hub_h2-2">
                    {link.icon === 'Mail'
                      ? 'The Clear Quran'
                      : 'The Quran Project'}
                  </h3>
                )}
                <p class="variant-hub_p-11">Free for non-Muslims</p>
                <p class="variant-hub_p-12">
                  {link.icon === 'Mail'
                    ? 'USA only. One English copy from One Message Foundation.'
                    : 'English translation with chapter introductions. Check delivery eligibility with the provider.'}
                </p>
                <a href={link.url} class="variant-hub_a-12">
                  {link.icon === 'Mail'
                    ? 'Request The Clear Quran'
                    : 'Request The Quran Project'}{' '}
                  <ArrowUpRight size={16} />
                </a>
              </article>
            ))}
          </div>
          {book && (
            <details class="group/book variant-hub_details">
              <summary class="variant-hub_summary-2">
                The book Ayoub uses{' '}
                <ChevronDown
                  size={17}
                  className="u-group-open-book-rotate-180"
                />
              </summary>
              <p class="variant-hub_p-13">
                The Clear Quran, English + Arabic. Paid paperback; Ayoub's
                spiral binding was done locally.
              </p>
              <a href={book.url} class="variant-hub_a-13">
                View at Furqaan Bookstore <ArrowUpRight size={16} />
              </a>
            </details>
          )}
        </Section>
        <Section id="watch" data-panel class={sectionClass}>
          {focus ? (
            <summary class="variant-hub_summary">
              <span class={titleClass}>Watch & keep learning</span>
              <ChevronDown size={20} className="u-group-open-rotate-180" />
            </summary>
          ) : (
            <h2 class={titleClass}>
              {journal ? 'Watch & reflect' : 'Watch and learn'}
            </h2>
          )}
          <a href={youtube} class="variant-hub_a-14">
            Ayoub's recordings <ArrowUpRight size={16} />
          </a>
          <div class="variant-hub_div-15">
            {videos.map((link) => {
              const thumbnail = link.youtube?.includes('PLlZaz')
                ? 'sQMC7fkjmOA'
                : link.youtube?.includes('PL9821')
                  ? 'IQjzErJlpJ0'
                  : link.youtube;
              return (
                <a
                  href={link.url}
                  class:list={[
                    'group/video',
                    journal ? 'display-block' : 'variant-hub_a-15',
                  ]}
                >
                  <span
                    class:list={[
                      'variant-hub_span-2',
                      journal ? 'variant-hub_span-3' : 'variant-hub_span-4',
                    ]}
                  >
                    <Image
                      src={`https://i.ytimg.com/vi/${thumbnail}/hqdefault.jpg`}
                      width={480}
                      height={360}
                      widths={[160, 320, 480]}
                      quality={70}
                      sizes={
                        journal ? '(min-width: 1024px) 480px, 90vw' : '80px'
                      }
                      alt=""
                      loading="lazy"
                      class="variant-hub_image-4"
                    />
                  </span>
                  <span class="variant-hub_span-5">
                    <span class="variant-hub_span-6">
                      {link.title.replaceAll('—', '-')}
                    </span>
                    <span class="variant-hub_span-7">
                      {link.youtube?.startsWith('videoseries')
                        ? 'Watch playlist'
                        : 'Watch video'}{' '}
                      <ArrowUpRight size={14} />
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
        </Section>
        <Section
          id="more"
          data-panel
          class:list={[sectionClass, journal && 'u-sm-col-span-2']}
        >
          {focus ? (
            <summary class="variant-hub_summary">
              <span class={titleClass}>Explore a little further</span>
              <ChevronDown size={20} className="u-group-open-rotate-180" />
            </summary>
          ) : (
            <h2 class={titleClass}>More from the live</h2>
          )}
          <div class="u-mt-3">
            {resources.map((link) => (
              <a href={link.url} class="variant-hub_a-16">
                {shortNames[link.icon] ?? link.title}
                <ArrowUpRight size={18} />
              </a>
            ))}
          </div>
        </Section>
      </div>
    </main>
    <footer class="variant-hub_footer">
      {support && (
        <a href={support.url} class="variant-hub_a-17">
          <Heart size={16} />
          Support the live on Ko-fi <ArrowUpRight size={14} />
        </a>
      )}
      <nav aria-label="Social profiles" class="variant-hub_nav-3">
        <a href="https://go.alphabravomedia.co/islam-tiktok" class="u-py-3">
          TikTok
        </a>
        <a href="https://go.alphabravomedia.co/islam-twitch" class="u-py-3">
          Twitch
        </a>
        <a href={youtube} class="u-py-3">
          YouTube
        </a>
      </nav>
      <details class="variant-hub_details-2">
        <summary class="variant-hub_summary-3">About & privacy</summary>
        <p class="variant-hub_p-14">
          Quran reading resources shared by Ayoub. Contact him through his
          profiles above. No forms, accounts, or sign-ins on this page. External
          services have their own privacy policies.
        </p>
      </details>
    </footer>
  </div>
</div>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-task]')
  );
  if (tabs.length) {
    const nav = document.querySelector<HTMLElement>('[data-task-tabs]');
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-panel]')
    );
    const activate = (id: string, moveFocus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.task === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.id !== id;
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', `tab-${panel.id}`);
        panel.tabIndex = 0;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.task!));
      tab.addEventListener('keydown', (event) => {
        let target: number;
        if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft')
          target = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[target].dataset.task!, true);
      });
    });
    activate('read');
    if (nav) nav.hidden = false;
  }
</script>
