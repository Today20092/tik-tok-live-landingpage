---
import { buttonVariants } from '@/components/ui/button';
import { IconCopy, IconCheck } from '@tabler/icons-react';
import ArticleImageViewer from '@/components/ArticleImageViewer';
---

<template id="section-link-template">
  <a
    data-pagefind-ignore
    class={buttonVariants({
      variant: 'outline',
      size: 'sm',
      className: 'section-copy-link',
    })}
  >
    <IconCopy className="section-copy-idle" aria-hidden="true" />
    <IconCheck className="section-copy-check" aria-hidden="true" />
    <span data-section-copy-label>Copy link</span>
  </a>
</template>
<p
  id="section-copy-status"
  role="status"
  class="visually-hidden"
  data-pagefind-ignore
></p>
<ArticleImageViewer client:idle />

<script>
  const template = document.querySelector<HTMLTemplateElement>(
    '#section-link-template'
  );
  const status = document.getElementById('section-copy-status');
  if (template && status) {
    document
      .querySelectorAll<HTMLElement>(
        '#article-body h2[id], #article-body h3[id], #article-body h4[id]'
      )
      .forEach((heading) => {
        const link = template.content.firstElementChild!.cloneNode(
          true
        ) as HTMLAnchorElement;
        const label = heading.textContent ?? 'section';
        heading.dataset.sectionTitle = label;
        const url = new URL(
          document.querySelector<HTMLLinkElement>('link[rel="canonical"]')
            ?.href ?? window.location.href
        );
        url.hash = heading.id;
        link.href = url.href;
        link.setAttribute('aria-label', `Copy link to ${label}`);
        link.title = `Copy link to ${label}`;
        const copyLabel = link.querySelector<HTMLElement>(
          '[data-section-copy-label]'
        )!;
        link.addEventListener('click', async (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
            return;
          event.preventDefault();
          status.textContent = '';
          try {
            await navigator.clipboard.writeText(url.href);
            status.textContent = `Link to ${label} copied.`;
            link.title = 'Link copied';
            copyLabel.textContent = 'Copied';
            link.dataset.copied = '';
            window.setTimeout(() => {
              copyLabel.textContent = 'Copy link';
              delete link.dataset.copied;
              link.title = `Copy link to ${label}`;
            }, 2000);
          } catch {
            delete link.dataset.copied;
            copyLabel.textContent = 'Copy link';
            link.title = `Copy link to ${label}`;
            window.location.hash = heading.id;
            status.textContent =
              'Copy this section’s address from your browser address bar.';
          }
        });
        const text = document.createElement('span');
        text.className = 'min-width-0';
        text.append(...heading.childNodes);
        heading.classList.add('article-section-heading');
        heading.replaceChildren(text, link);
      });
  }
</script>
