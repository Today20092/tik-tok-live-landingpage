---
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.slice(base.length).replace(/\/$/, '');
const links = [
  { label: 'Links', path: '', active: current === '' || current === 'pocket' },
  {
    label: 'Articles',
    path: 'articles/',
    active: current.startsWith('articles'),
  },
  { label: 'About', path: 'articles/why-i-started/', active: false },
  { label: 'Search', path: 'search/', active: current === 'search' },
];
---

<header
  data-site-header
  data-pagefind-ignore
  class="mx-auto w-full max-w-4xl px-5 pt-5 sm:px-8 sm:pt-7"
>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-border pb-3">
    <a
      href={base}
      class="flex min-h-11 items-center gap-3 rounded-sm text-foreground"
    >
      <img
        src={`${base}ayoub-portrait.jpg`}
        alt=""
        width="40"
        height="40"
        class="size-10 rounded-full object-cover object-[center_25%] ring-1 ring-border"
      />
      <span class="font-serif text-lg font-semibold tracking-tight">
        Islam with Ayoub
      </span>
    </a>
    <nav
      aria-label="Site"
      class="flex w-full items-center justify-between gap-1 text-sm font-medium sm:w-auto sm:gap-2"
    >
      {links.map(({ label, path, active }) => (
        <a
          href={`${base}${path}`}
          aria-current={
            active
              ? current === path.replace(/\/$/, '')
                ? 'page'
                : 'location'
              : undefined
          }
          class:list={[
            'inline-flex min-h-11 items-center rounded-md px-3 transition-colors hover:bg-secondary',
            active
              ? 'bg-secondary text-primary underline decoration-primary decoration-2 underline-offset-8'
              : 'text-muted-foreground',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
