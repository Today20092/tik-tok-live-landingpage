---
import { Image } from 'astro:assets';
import portrait from '../assets/ayoub-portrait.jpg';
import ThemeControl from './ThemeControl.astro';
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.slice(base.length).replace(/\/$/, '');
const links = [
  { label: 'Links', path: '', active: current === '' || current === 'pocket' },
  {
    label: 'Articles',
    path: 'articles/',
    active: current.startsWith('articles'),
  },
  { label: 'About', path: 'articles/why-i-started/', active: false },
  { label: 'Search', path: 'search/', active: current === 'search' },
];
---

<header data-site-header data-pagefind-ignore class="site-header">
  <div class="site-header_row">
    <a href={base} class="site-header_brand">
      <Image
        src={portrait}
        alt=""
        width={40}
        height={50}
        densities={[1, 2]}
        loading="eager"
        class="site-header_portrait"
      />
      <span class="site-header_name">Islam with Ayoub</span>
    </a>
    <nav aria-label="Site" class="site-header_navigation">
      {links.map(({ label, path, active }) => (
        <a
          href={`${base}${path}`}
          aria-current={
            active
              ? current === path.replace(/\/$/, '')
                ? 'page'
                : 'location'
              : undefined
          }
          class:list={[
            'site-header_link',
            active ? 'site-header_link-current' : 'text-muted',
          ]}
        >
          {label}
        </a>
      ))}
      <ThemeControl />
    </nav>
  </div>
</header>
