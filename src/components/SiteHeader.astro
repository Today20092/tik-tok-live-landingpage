---
import { Image } from 'astro:assets';
import portrait from '../assets/ayoub-portrait.jpg';
import ThemeControl from './ThemeControl.astro';
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.slice(base.length).replace(/\/$/, '');
const links = [
  {
    label: 'Books & resources',
    path: '',
    active: current === '',
  },
  {
    label: 'Articles',
    path: 'articles/',
    active:
      (current === 'articles' || current.startsWith('articles/')) &&
      current !== 'articles/about-me',
  },
  {
    label: 'Printables',
    path: 'printables/',
    active: current === 'printables',
  },
  {
    label: 'About Ayoub',
    path: 'articles/about-me/',
    active: current === 'articles/about-me',
  },
  { label: 'Search', path: 'search/', active: current === 'search' },
];
---

<header data-site-header data-pagefind-ignore class="site-header">
  <div class="site-header_row">
    <a href={base} class="site-header_brand">
      <Image
        src={portrait}
        alt=""
        width={40}
        height={50}
        densities={[1, 2]}
        loading="eager"
        class="site-header_portrait"
      />
      <span class="site-header_name">Islam with Ayoub</span>
    </a>
    <nav aria-label="Site" class="site-header_navigation">
      {links.map(({ label, path, active }) => (
        <a
          href={`${base}${path}`}
          aria-current={
            active
              ? current === path.replace(/\/$/, '')
                ? 'page'
                : 'location'
              : undefined
          }
          class:list={[
            'site-header_link',
            active ? 'site-header_link-current' : 'text-muted',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="site-header_tools">
      <ThemeControl />
      <div class="site-header_menu">
        <button
          type="button"
          class="control control-outline"
          popovertarget="site-menu"
          aria-controls="site-menu"
        >
          Menu
        </button>
        <nav id="site-menu" popover aria-label="Mobile site navigation">
          {links.map(({ label, path, active }) => (
            <a
              href={`${base}${path}`}
              aria-current={
                active
                  ? current === path.replace(/\/$/, '')
                    ? 'page'
                    : 'location'
                  : undefined
              }
              class:list={[
                'site-header_link',
                active ? 'site-header_link-current' : 'text-muted',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</header>
<script>
  const menu = document.getElementById('site-menu');
  const button = document.querySelector('[popovertarget="site-menu"]');
  if (menu && button && Object.hasOwn(HTMLElement.prototype, 'popover')) {
    // The top-layer menu is fixed to the viewport; open it just below its button.
    menu.addEventListener('beforetoggle', () => {
      menu.style.top = `${button.getBoundingClientRect().bottom + 4}px`;
    });
  } else if (menu && button) {
    // Fallback without the Popover API: toggle the menu with hidden.
    menu.removeAttribute('popover');
    menu.hidden = true;
    button.setAttribute('aria-expanded', 'false');
    button.addEventListener('click', () => {
      menu.hidden = !menu.hidden;
      button.setAttribute('aria-expanded', String(!menu.hidden));
    });
  }
</script>
<style>
  @layer components {
    .site-header_row {
      position: relative;
    }
    .site-header_tools {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }
    .site-header_menu {
      display: none;
    }
    @media (width < 40rem) {
      .site-header {
        padding-top: var(--space-2);
      }
      .site-header_row {
        column-gap: var(--space-2);
        row-gap: var(--space-1);
        padding-bottom: var(--space-2);
      }
      .site-header_brand {
        gap: var(--space-2);
      }
      .site-header_portrait {
        width: 2rem;
        height: 2rem;
      }
      .site-header_name {
        font-size: var(--text-base);
      }
      .site-header_navigation {
        display: none;
      }
      .site-header_menu {
        display: block;
      }
      .site-header_menu nav {
        position: absolute;
        inset: 100% 0 auto auto;
        margin: 0;
        z-index: 20;
        width: 12rem;
        max-width: 100%;
        color: inherit;
        padding: var(--space-2);
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-main);
        &:is(:popover-open, :not([popover])) {
          display: grid;
        }
      }
      .site-header_menu nav:popover-open {
        position: fixed;
        inset: auto var(--space-4) auto auto;
        max-width: calc(100% - 2 * var(--space-4));
        max-height: 80dvh;
        overflow-y: auto;
      }
    }
  }
</style>
