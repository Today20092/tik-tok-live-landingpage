---
import {
  IconArrowUpRight as ArrowUpRight,
  IconBook as BookOpen,
  IconPencil as PencilLine,
  IconCompass as Compass,
  IconBrandTiktok,
  IconBrandTwitch,
  IconBrandYoutube,
} from '@tabler/icons-react';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import hoursCover from '../assets/books/80000-hours-paperback.jpg';
import ArticleList from './ArticleList.astro';
import LearningVideos from './LearningVideos.astro';
import ReadingResources from './ReadingResources.astro';
interface Props { readingLayout?: 'note' | 'split' | 'minimal' }
const { readingLayout = 'split' } = Astro.props;
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const links = (await getCollection('links')).map((entry) => entry.data);
const youtube = 'https://go.alphabravomedia.co/islam-youtube';
const introduction = links.find((link) => link.icon === 'PencilLine');
if (!introduction)
  throw new Error('The beginner introduction resource is required.');
const videos = links.filter((link) => link.youtube);
const resources = links.filter(
  (link) =>
    !link.variant &&
    !link.youtube &&
    !['Scroll', 'PencilLine'].includes(link.icon)
);
const resourceLabels: Record<
  string,
  { title?: string; description?: string; Icon: typeof BookOpen }
> = {
  PencilLine: {
    Icon: PencilLine,
  },
  Compass: {
    Icon: Compass,
  },
};
const button = 'resource-card hub-resource-row';
const secondary = button;
---

<div data-pocket-hub class="pocket-hub">
  <div class="pocket-hub_content">
    {Astro.slots.has('books') && <h1 class="live-intro_title">Books from the live</h1>}
    <main
      class="pocket-hub_main"
      data-pagefind-body={Astro.url.pathname === base ? '' : undefined}
      data-pagefind-filter="Type:Resources"
    >
      <div id="read">
        <slot name="books">
          <ReadingResources layout={readingLayout} />
        </slot>
      </div>
      <section id="start-here" aria-labelledby="start-title" class="live-help">
        <h2 id="start-title" class="pocket-hub_copies-title">
          New to Islam? You're welcome here.
        </h2>
        <p>
          You can listen, read along, and ask basic questions during the live.
          You don't need to buy a book or know anything about Islam to join.
        </p>
        <details class="live-help_details">
          <summary>Questions about reading along</summary>
          <dl class="live-help_questions">
          <div>
            <dt>Is Meadows of the Righteous the Quran?</dt>
            <dd>
              No. It is a collection of hadith, reports of what Prophet Muhammad
              said and did, with Quran passages alongside them. The Quran is
              Islam's scripture, believed by Muslims to be God's revelation.
            </dd>
          </div>
          <div>
            <dt>Where are we reading today?</dt>
            <dd>
              Ask me for the chapter or hadith number in the live. Page numbers
              can differ between the printed book and PDF.
            </dd>
          </div>
          <div>
            <dt>Which Quran should I choose?</dt>
            <dd>
              To recognise the book from my earlier lives, choose The Clear
              Quran in English and Arabic. For my article quotations, I normally
              use M. A. S. Abdel Haleem. You can also start with the free online
              reader before choosing a print edition.
            </dd>
          </div>
          </dl>
        </details>
        <a href={introduction.url} class={secondary}>
          <BookOpen size={23} aria-hidden="true" className="flex-noshrink" />
          <span class="resource-card_content">
            <span class="resource-card_title">
              Start here: why Islam isn't a new religion
            </span>
            <span class="resource-card_description">
              The diagram I share on live, introducing how Islam connects with
              earlier prophets.
            </span>
          </span>
          <ArrowUpRight
            size={18}
            aria-hidden="true"
            className="flex-noshrink"
          />
        </a>
      </section>
      <section id="join" aria-labelledby="join-title" class="live-help">
        <h2 id="join-title" class="pocket-hub_copies-title">
          Join the next reading
        </h2>
        <p>
          Follow my TikTok profile for future lives. Missed a session? Find
          recorded readings on YouTube.
        </p>
        <nav aria-label="Ayoub's social profiles" class="live-intro_nav">
          <a
            href="https://go.alphabravomedia.co/islam-tiktok"
            class="control control-primary"
          >
            <IconBrandTiktok size={18} aria-hidden="true" /> Follow on TikTok
          </a>
          <a
            href="https://go.alphabravomedia.co/islam-twitch"
            class="control control-ghost"
          >
            <IconBrandTwitch size={18} aria-hidden="true" /> Twitch
          </a>
          <a href={youtube} class="control control-ghost">
            <IconBrandYoutube size={18} aria-hidden="true" /> Watch recordings
          </a>
        </nav>
      </section>
      <section
        id="watch"
        aria-labelledby="watch-title"
        class="pocket-hub_copies"
      >
        <h2 id="watch-title" class="pocket-hub_copies-title">
          Keep learning
        </h2>
        <LearningVideos videos={videos} />
      </section>
      {articles.length > 0 && (
        <section
          aria-labelledby="articles-title"
          class="u-pt-8"
          data-pagefind-ignore
        >
          <div class="pocket-hub_div-5">
            <h2 id="articles-title" class="pocket-hub_articles-title">
              Articles & understanding
            </h2>
            <a href={`${base}articles/`} class="pocket-hub_a-3">
              View all <ArrowUpRight size={14} />
            </a>
          </div>
          <ArticleList articles={articles.slice(0, 3)} heading="h3" />
        </section>
      )}
      <section id="more" aria-labelledby="more-title" class="pocket-hub_more">
        <h2 id="more-title" class="pocket-hub_copies-title">
          More from the live
        </h2>
        <div class="pocket-hub_div-4">
          <article class="career-book">
            <div class="career-book_cover"><Image src={hoursCover} alt="80,000 Hours by Benjamin Todd cover" width={240} loading="lazy" /></div>
            <div>
              <h3>80,000 Hours</h3>
              <p class="text-small">Benjamin Todd</p>
              <p>A guide to finding a fulfilling career that does good.</p>
              <p><a href={`${base}articles/80000-hours/`}>Why I recommend reading it before choosing a major</a></p>
              <div class="live-intro_nav">
                <a class="control control-outline" href="https://80000hours.org/career-guide/">Read free online ↗</a>
                <a class="control control-outline" href="https://amzn.to/4xXs8Yo" rel="sponsored">Buy paperback ↗</a>
              </div>
              <p class="text-small">Paid paperback. Amazon affiliate link; I earn from qualifying purchases.</p>
            </div>
          </article>
          {resources.filter((link) => link.icon !== 'Compass').map((link) => {
            const label = resourceLabels[link.icon];
            const Icon = label?.Icon ?? BookOpen;
            return (
              <a href={link.url} class={secondary}>
                <Icon size={22} strokeWidth={1.5} className="flex-noshrink" />
                <span class="resource-card_content">
                  <span class="pocket-hub_span-7">
                    {label?.title ?? link.title}
                  </span>{' '}
                  <span class="resource-card_description">
                    {label?.description ?? link.description}
                  </span>{' '}
                </span>
                <ArrowUpRight size={17} className="flex-noshrink" />
              </a>
            );
          })}
        </div>
      </section>
    </main>
  </div>
</div>

<style>
  @layer components {
    .pocket-hub_content { padding-top: var(--space-4); }
    .hub-resource-row { background: transparent; border-radius: 0; border: 0; border-bottom: 1px solid var(--border); box-shadow: none; padding: var(--space-4) 0; }
    .hub-resource-row::before, .hub-resource-row::after { display: none; }
    .hub-resource-row:hover { transform: none; box-shadow: none; }
    .career-book { display: grid; grid-template-columns: minmax(0, 8rem) minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-4); }
    .pocket-hub_copies-title, .pocket-hub_articles-title { font-family: var(--font-serif); font-size: var(--text-2xl); line-height: var(--leading-tight); padding-inline: 0; }
    .pocket-hub :global(.article-list_heading), .pocket-hub :global(.learning-videos_h3), .career-book h3, .pocket-hub :global(.reading-book h3) { font-size: var(--text-xl); line-height: var(--leading-tight); }
    :global(.site-main:has([data-pocket-hub]) + .share-page .share-page_share-title) { font-size: var(--text-2xl); line-height: var(--leading-tight); }
    .pocket-hub_copies { padding-top: 0; margin-top: var(--space-6); }
    #watch-title { margin-bottom: var(--space-5); }
    .career-book { padding-bottom: 0; }
    .career-book > div > p:last-child { margin-bottom: 0; }
    :global(.site-main:has([data-pocket-hub]) + .share-page) { margin-top: var(--space-4); }
    .pocket-hub_div-5 { flex-wrap: wrap; gap: var(--space-2); }
    .pocket-hub :global(h2), .pocket-hub :global(h3) { overflow-wrap: anywhere; }
    .career-book_cover { display: grid; place-items: center; align-self: start; padding: var(--space-3); background: var(--secondary); border-radius: var(--radius-main); }
    .career-book_cover img { width: 100%; height: auto; object-fit: contain; }
    .career-book h3 { margin: 0; }
    .career-book p { margin-block: var(--space-2); }
    .career-book .text-small { color: var(--muted-foreground); }
    @media (width < 30rem) { .career-book { grid-template-columns: minmax(0, 1fr); } .career-book_cover img { width: auto; max-width: 100%; height: 10rem; } }
    .live-intro_title {
      margin-top: 0;
      font-family: var(--font-serif);
      font-size: var(--text-4xl);
      line-height: var(--leading-tight);
      text-wrap: balance;
    }
    .live-intro_description {
      max-width: 60ch;
      margin-top: var(--space-3);
      color: var(--muted-foreground);
    }
    .live-intro_nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-block: var(--space-4);
    }
    .live-intro_nav a {
      white-space: normal;
    }
    .live-help {
      display: grid;
      gap: var(--space-4);
      margin-block: var(--space-8);
      scroll-margin-top: var(--space-5);
    }
    .live-help > * { margin-block: 0; }
    .live-help > h2 { padding-inline: 0; }
    .live-help_details summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); cursor: pointer; padding-block: var(--space-3); min-height: var(--control-height); border-block: 1px solid var(--border); }
    .live-help_details summary::after { content: '+'; flex-shrink: 0; }
    .live-help_details[open] summary::after { content: '−'; }
    .live-help > p {
      max-width: 65ch;
      margin-bottom: 0;
    }
    .live-help_questions {
      display: grid;
      gap: var(--space-5);
      margin-block: var(--space-5);
    }
    .live-help_questions dt {
      font-weight: 600;
    }
    .live-help_questions dd {
      margin: var(--space-2) 0 0;
      max-width: 65ch;
      color: var(--muted-foreground);
    }
    .pocket-hub_nav {
      flex-wrap: wrap;
    }
    .resource-card {
      overflow-wrap: anywhere;
    }
  }
</style>
