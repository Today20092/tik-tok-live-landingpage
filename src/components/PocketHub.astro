---
import { Image } from 'astro:assets';
import portrait from '../assets/ayoub-portrait.jpg';
import {
  IconArrowUpRight as ArrowUpRight,
  IconBook as BookOpen,
  IconBook2 as Book,
  IconPlayerPlay as Play,
  IconPackage as PackageOpen,
  IconPencil as PencilLine,
  IconCompass as Compass,
  IconScript as Scroll,
  IconBrandTiktok,
  IconBrandTwitch,
  IconBrandYoutube,
} from '@tabler/icons-react';
import { getCollection } from 'astro:content';
import ArticleList from './ArticleList.astro';
import LearningVideos from './LearningVideos.astro';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const links = (await getCollection('links')).map((entry) => entry.data);
const youtube = 'https://www.youtube.com/channel/UCQ5YfTwU5n_khZx-WJEkZKQ';
const read = links.find((link) => link.url === 'https://quran.com');
const book = links.find((link) => link.variant === 'stream-pick');
const support = links.find((link) => link.variant === 'support');
const copies = links.filter(
  (link) => link.variant === 'featured' && link !== read
);
const videos = links.filter((link) => link.youtube);
const resources = links.filter((link) => !link.variant && !link.youtube);
const resourceLabels: Record<
  string,
  { title?: string; description?: string; Icon: typeof BookOpen }
> = {
  PencilLine: {
    Icon: PencilLine,
  },
  Scroll: {
    Icon: Scroll,
  },
  Compass: {
    Icon: Compass,
  },
};
const paperCard =
  'rounded-lg shadow-[4px_4px_0_var(--paper-shadow,#d4ded0),5px_5px_0_var(--paper-edge,#9dad97)] ring-1 ring-[var(--paper-edge,#9dad97)] transition-[box-shadow,transform,background-color] duration-200 focus-visible:outline-offset-8 motion-reduce:transform-none';
const button = `${paperCard} group flex min-h-20 w-full items-center gap-4 px-5 py-4 hover:-translate-y-0.5 active:scale-[0.99]`;
const secondary = `${button} bg-secondary text-secondary-foreground hover:bg-accent`;
---

<div data-pocket-hub class="relative font-sans text-foreground">
  <div class="relative mx-auto max-w-5xl px-5 pb-2 pt-6 sm:px-8 sm:pt-8">
    <header class="text-center">
      <div class="relative isolate flex h-52 items-center overflow-hidden rounded-xl bg-accent text-accent-foreground text-left shadow-[6px_6px_0_var(--paper-shadow,#d4ded0),7px_7px_0_var(--paper-edge,#9dad97)] sm:h-60">
        <Image
          src={portrait}
          alt="Ayoub smiling"
          widths={[320, 640, 960, 1280]}
          sizes="(min-width: 1024px) 650px, 68vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-y-0 right-0 -z-10 h-full w-[52%] origin-[center_30%] scale-[1.3] object-cover object-[center_30%]"
        />
        <h1 class="flex w-[48%] shrink-0 self-stretch items-center bg-accent px-5 text-3xl font-semibold leading-tight tracking-tight sm:px-7 sm:text-4xl">
          Islam with Ayoub
        </h1>
      </div>
      <p class="mx-auto mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
        Read the Quran, find a copy, and explore the links from our live
        sessions.
      </p>
      <nav
        aria-label="Ayoub's social profiles"
        class="mt-3 flex justify-center gap-1 text-xs font-medium"
      >
        <a
          href="https://www.tiktok.com/@ayoubabedrabbo"
          class="inline-flex min-h-11 items-center gap-1 rounded-full px-3 hover:bg-secondary"
        >
          <IconBrandTiktok size={18} aria-hidden="true" /> TikTok
        </a>
        <a
          href="https://www.twitch.tv/ayoubabedrabbo"
          class="inline-flex min-h-11 items-center gap-1 rounded-full px-3 hover:bg-secondary"
        >
          <IconBrandTwitch size={18} aria-hidden="true" /> Twitch
        </a>
        <a
          href={youtube}
          class="inline-flex min-h-11 items-center gap-1 rounded-full px-3 hover:bg-secondary"
        >
          <IconBrandYoutube size={18} aria-hidden="true" /> YouTube
        </a>
      </nav>
    </header>
    <main
      class="mt-6"
      data-pagefind-body={Astro.url.pathname === base ? '' : undefined}
      data-pagefind-filter="Type:Resources"
    >
      <section id="read" aria-label="Start here" class="grid scroll-mt-5 gap-3">
        {read && (
          <a
            href={read.url}
            class={`${button} bg-primary text-primary-foreground hover:brightness-95`}
          >
            <BookOpen size={24} strokeWidth={1.5} className="shrink-0" />
            <span class="min-w-0 flex-1">
              <span class="block text-base font-semibold">
                Read Quran in English
              </span>{' '}
              <span class="mt-1 block text-xs text-primary-foreground">
                Free translation & audio on Quran.com
              </span>{' '}
            </span>
            <ArrowUpRight size={19} className="shrink-0" />
          </a>
        )}
        <a href={youtube} class={secondary}>
          <Play size={23} strokeWidth={1.5} className="shrink-0" />
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold">
              Watch the recordings
            </span>{' '}
            <span class="mt-1 block text-xs text-muted-foreground">
              Catch up with Ayoub on YouTube
            </span>{' '}
          </span>
          <ArrowUpRight size={18} className="shrink-0" />
        </a>
        {book && (
          <div>
            <a href={book.url} class={secondary}>
              <Book size={23} strokeWidth={1.5} className="shrink-0" />
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold">
                  The book I read on stream
                </span>{' '}
                <span class="mt-1 block text-xs text-muted-foreground">
                  The Clear Quran · English + Arabic
                </span>{' '}
              </span>
              <ArrowUpRight size={18} className="shrink-0" />
            </a>
            <p class="px-5 pt-2 text-sm leading-relaxed text-muted-foreground">
              Paid paperback. My spiral binding was done locally.
            </p>
          </div>
        )}
      </section>
      <section
        id="copies"
        aria-labelledby="copies-title"
        class="scroll-mt-5 pt-8"
      >
        <h2 id="copies-title" class="mb-3 px-1 text-lg font-semibold">
          Get a free English copy
        </h2>
        <div class="grid gap-3">
          {copies.map((link) => (
            <a href={link.url} class={secondary}>
              <PackageOpen size={23} strokeWidth={1.5} className="shrink-0" />
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold">
                  {link.icon === 'Mail'
                    ? 'Request The Clear Quran'
                    : 'Request The Quran Project'}
                </span>{' '}
                <span class="mt-1 block text-sm leading-relaxed text-muted-foreground">
                  {link.icon === 'Mail'
                    ? 'Free for non-Muslims in the USA. One copy.'
                    : 'Free for non-Muslims. Check delivery eligibility.'}
                </span>{' '}
              </span>
              <ArrowUpRight size={18} className="shrink-0" />
            </a>
          ))}
        </div>
      </section>
      <section
        id="watch"
        aria-labelledby="watch-title"
        class="scroll-mt-5 pt-8"
      >
        <h2 id="watch-title" class="mb-3 px-1 text-lg font-semibold">
          Keep learning
        </h2>
        <LearningVideos videos={videos} />
      </section>
      {articles.length > 0 && (
        <section
          aria-labelledby="articles-title"
          class="pt-8"
          data-pagefind-ignore
        >
          <div class="mb-3 flex items-center justify-between">
            <h2 id="articles-title" class="text-lg font-semibold">
              Articles & understanding
            </h2>
            <a
              href={`${base}articles/`}
              class="inline-flex min-h-11 items-center gap-1 text-xs font-medium"
            >
              View all <ArrowUpRight size={14} />
            </a>
          </div>
          <ArticleList articles={articles.slice(0, 3)} heading="h3" />
        </section>
      )}
      <section id="more" aria-labelledby="more-title" class="scroll-mt-5 pt-7">
        <h2 id="more-title" class="mb-3 px-1 text-lg font-semibold">
          More from the live
        </h2>
        <div class="grid gap-3">
          {resources.map((link) => {
            const label = resourceLabels[link.icon];
            const Icon = label?.Icon ?? BookOpen;
            return (
              <a href={link.url} class={secondary}>
                <Icon size={22} strokeWidth={1.5} className="shrink-0" />
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium">
                    {label?.title ?? link.title}
                  </span>{' '}
                  <span class="mt-1 block text-xs text-muted-foreground">
                    {label?.description ?? link.description}
                  </span>{' '}
                </span>
                <ArrowUpRight size={17} className="shrink-0" />
              </a>
            );
          })}
        </div>
      </section>
      {support && (
        <a
          href={support.url}
          class={`${paperCard} mt-6 flex min-h-24 items-center gap-4 border-2 border-[#ff6433] bg-card text-card-foreground p-5 hover:bg-[var(--support-hover,#fff1eb)] dark:hover:bg-secondary`}
        >
          <img
            src="https://cdn.prod.website-files.com/5c14e387dab576fe667689cf/670f5a01229bf8a18f97a3c1_favion.avif"
            alt=""
            width="48"
            height="48"
            loading="lazy"
            class="size-12 shrink-0 object-contain"
          />
          <span class="min-w-0 flex-1">
            <span class="block text-base font-semibold">
              Support my work on Ko-fi
            </span>{' '}
            <span class="mt-1 block text-sm leading-relaxed text-muted-foreground">
              If you'd like to support my videos, articles, and live readings,
              you can leave an optional tip.
            </span>
          </span>
        </a>
      )}
    </main>
  </div>
</div>
