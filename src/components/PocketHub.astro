---
import { Image } from 'astro:assets';
import portrait from '../assets/ayoub-portrait.jpg';
import {
  IconArrowUpRight as ArrowUpRight,
  IconBook as BookOpen,
  IconBook2 as Book,
  IconPlayerPlay as Play,
  IconPencil as PencilLine,
  IconCompass as Compass,
  IconBrandTiktok,
  IconBrandTwitch,
  IconBrandYoutube,
} from '@tabler/icons-react';
import { getCollection } from 'astro:content';
import ArticleList from './ArticleList.astro';
import LearningVideos from './LearningVideos.astro';
import BookShelf from './BookShelf.astro';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const links = (await getCollection('links')).map((entry) => entry.data);
const youtube = 'https://go.alphabravomedia.co/islam-youtube';
const read = links.find((link) => link.icon === 'BookOpen');
const book = links.find((link) => link.variant === 'stream-pick');
const support = links.find((link) => link.variant === 'support');
const videos = links.filter((link) => link.youtube);
const resources = links.filter((link) => !link.variant && !link.youtube && link.icon !== 'Scroll');
const resourceLabels: Record<
  string,
  { title?: string; description?: string; Icon: typeof BookOpen }
> = {
  PencilLine: {
    Icon: PencilLine,
  },
  Compass: {
    Icon: Compass,
  },
};
const paperCard = 'pocket-hub_papercard';
const button = 'resource-card';
const secondary = button;
---

<div data-pocket-hub class="pocket-hub">
  <div class="pocket-hub_content">
    <header class="u-text-center">
      <div class="pocket-hub_hero">
        <Image
          src={portrait}
          alt="Ayoub smiling"
          widths={[320, 640, 960, 1280]}
          sizes="(min-width: 1024px) 650px, 68vw"
          loading="eager"
          fetchpriority="high"
          class="pocket-hub_portrait"
        />
        <h1 class="pocket-hub_title">Islam with Ayoub</h1>
      </div>
      <p class="pocket-hub_intro">
        Read the Quran, find a copy, and explore the links from our live
        sessions.
      </p>
      <nav aria-label="Ayoub's social profiles" class="pocket-hub_nav">
        <a
          href="https://go.alphabravomedia.co/islam-tiktok"
          class="pocket-hub_a"
        >
          <IconBrandTiktok size={18} aria-hidden="true" /> TikTok
        </a>
        <a
          href="https://go.alphabravomedia.co/islam-twitch"
          class="pocket-hub_a"
        >
          <IconBrandTwitch size={18} aria-hidden="true" /> Twitch
        </a>
        <a href={youtube} class="pocket-hub_a">
          <IconBrandYoutube size={18} aria-hidden="true" /> YouTube
        </a>
      </nav>
    </header>
    <main
      class="u-mt-6"
      data-pagefind-body={Astro.url.pathname === base ? '' : undefined}
      data-pagefind-filter="Type:Resources"
    >
      <section id="read" aria-label="Start here" class="pocket-hub_read">
        {read && (
          <a href={read.url} class={`${button} resource-card-primary`}>
            <BookOpen size={24} strokeWidth={1.5} className="flex-noshrink" />
            <span class="resource-card_content">
              <span class="resource-card_title">Read Quran in English</span>{' '}
              <span class="resource-card_description">
                Free translation & audio on Quran.com
              </span>{' '}
            </span>
            <ArrowUpRight size={19} className="flex-noshrink" />
          </a>
        )}
        <a href={youtube} class={secondary}>
          <Play size={23} strokeWidth={1.5} className="flex-noshrink" />
          <span class="resource-card_content">
            <span class="resource-card_title">Watch the recordings</span>{' '}
            <span class="resource-card_description">
              Catch up with Ayoub on YouTube
            </span>{' '}
          </span>
          <ArrowUpRight size={18} className="flex-noshrink" />
        </a>
        {book && (
          <div>
            <a href={book.url} class={secondary}>
              <Book size={23} strokeWidth={1.5} className="flex-noshrink" />
              <span class="resource-card_content">
                <span class="resource-card_title">
                  The book I read on stream
                </span>{' '}
                <span class="resource-card_description">
                  The Clear Quran · English + Arabic
                </span>{' '}
              </span>
              <ArrowUpRight size={18} className="flex-noshrink" />
            </a>
            <p class="pocket-hub_p-2">
              Paid paperback. My spiral binding was done locally.
            </p>
          </div>
        )}
      </section>
      <slot name="books"><BookShelf /></slot>
      <section
        id="watch"
        aria-labelledby="watch-title"
        class="pocket-hub_copies"
      >
        <h2 id="watch-title" class="pocket-hub_copies-title">
          Keep learning
        </h2>
        <LearningVideos videos={videos} />
      </section>
      {articles.length > 0 && (
        <section
          aria-labelledby="articles-title"
          class="u-pt-8"
          data-pagefind-ignore
        >
          <div class="pocket-hub_div-5">
            <h2 id="articles-title" class="pocket-hub_articles-title">
              Articles & understanding
            </h2>
            <a href={`${base}articles/`} class="pocket-hub_a-3">
              View all <ArrowUpRight size={14} />
            </a>
          </div>
          <ArticleList articles={articles.slice(0, 3)} heading="h3" />
        </section>
      )}
      <section id="more" aria-labelledby="more-title" class="pocket-hub_more">
        <h2 id="more-title" class="pocket-hub_copies-title">
          More from the live
        </h2>
        <div class="pocket-hub_div-4">
          {resources.map((link) => {
            const label = resourceLabels[link.icon];
            const Icon = label?.Icon ?? BookOpen;
            return (
              <a href={link.url} class={secondary}>
                <Icon size={22} strokeWidth={1.5} className="flex-noshrink" />
                <span class="resource-card_content">
                  <span class="pocket-hub_span-7">
                    {label?.title ?? link.title}
                  </span>{' '}
                  <span class="resource-card_description">
                    {label?.description ?? link.description}
                  </span>{' '}
                </span>
                <ArrowUpRight size={17} className="flex-noshrink" />
              </a>
            );
          })}
        </div>
      </section>
      {support && (
        <a href={support.url} class={`${paperCard} pocket-hub_a-4`}>
          <img
            src="https://cdn.prod.website-files.com/5c14e387dab576fe667689cf/670f5a01229bf8a18f97a3c1_favion.avif"
            alt=""
            width="48"
            height="48"
            loading="lazy"
            class="pocket-hub_img"
          />
          <span class="resource-card_content">
            <span class="resource-card_title">Support my work on Ko-fi</span>{' '}
            <span class="resource-card_description">
              If you'd like to support my videos, articles, and live readings,
              you can leave an optional tip.
            </span>
          </span>
        </a>
      )}
    </main>
  </div>
</div>

<style>
  @layer components {
    .pocket-hub_nav { flex-wrap: wrap; }
    .resource-card { overflow-wrap: anywhere; }
  }
</style>
