---
import {
  IconArrowUpRight as ArrowUpRight,
  IconBook as BookOpen,
  IconBook2 as Book,
  IconPlayerPlay as Play,
  IconPackage as PackageOpen,
  IconPencil as PencilLine,
  IconCompass as Compass,
  IconScript as Scroll,
  IconBrandTiktok,
  IconBrandTwitch,
  IconBrandYoutube,
} from '@tabler/icons-react';
import { getCollection } from 'astro:content';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const links = (await getCollection('links')).map((entry) => entry.data);
const youtube = 'https://www.youtube.com/channel/UCQ5YfTwU5n_khZx-WJEkZKQ';
const read = links.find((link) => link.url === 'https://quran.com');
const book = links.find((link) => link.variant === 'stream-pick');
const support = links.find((link) => link.variant === 'support');
const copies = links.filter(
  (link) => link.variant === 'featured' && link !== read
);
const videos = links.filter((link) => link.youtube);
const resources = links.filter((link) => !link.variant && !link.youtube);
const resourceLabels: Record<
  string,
  { title?: string; description?: string; Icon: typeof BookOpen }
> = {
  PencilLine: {
    title: 'The live drawing board',
    description: 'Session diagrams & notes',
    Icon: PencilLine,
  },
  Scroll: {
    Icon: Scroll,
  },
  Compass: {
    Icon: Compass,
  },
};
const button =
  'group flex min-h-20 w-full items-center gap-4 rounded-3xl px-5 py-4 transition-[background-color,transform] duration-200 hover:-translate-y-0.5 active:scale-[0.99] motion-reduce:transform-none';
const secondary = `${button} bg-[#eaf0e5] hover:bg-[#e0e9d9]`;
---

<div class="min-h-dvh bg-[#f7f9f5] font-sans text-[#243a30]">
  <a
    href="#read"
    class="fixed top-3 left-3 z-50 -translate-y-24 rounded-full bg-white px-5 py-3 focus:translate-y-0"
  >
    Skip to links
  </a>
  <div class="mx-auto max-w-xl px-5 pb-8 pt-8 sm:px-8 sm:pt-12">
    <header class="text-center">
      <span class="mx-auto grid size-16 place-items-center rounded-full bg-[#e1eadc] text-[#254f39]">
        <BookOpen size={30} strokeWidth={1.5} aria-hidden="true" />
      </span>
      <h1 class="mt-4 text-2xl font-semibold tracking-tight">
        Live with Ayoub
      </h1>
      <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-[#52695b]">
        Read the Quran, find a copy, and explore the links from our live
        sessions.
      </p>
      <nav
        aria-label="Ayoub's social profiles"
        class="mt-3 flex justify-center gap-1 text-xs font-medium"
      >
        <a
          href="https://www.tiktok.com/@ayoubabedrabbo"
          class="inline-flex min-h-11 items-center gap-1 rounded-full px-3 hover:bg-[#eaf0e5]"
        >
          <IconBrandTiktok size={18} aria-hidden="true" /> TikTok
        </a>
        <a
          href="https://www.twitch.tv/ayoubabedrabbo"
          class="inline-flex min-h-11 items-center gap-1 rounded-full px-3 hover:bg-[#eaf0e5]"
        >
          <IconBrandTwitch size={18} aria-hidden="true" /> Twitch
        </a>
        <a
          href={youtube}
          class="inline-flex min-h-11 items-center gap-1 rounded-full px-3 hover:bg-[#eaf0e5]"
        >
          <IconBrandYoutube size={18} aria-hidden="true" /> YouTube
        </a>
      </nav>
      <nav
        aria-label="Site"
        class="mt-1 flex justify-center gap-4 text-sm font-medium"
      >
        <a
          href={`${base}articles/`}
          class="inline-flex min-h-11 items-center underline-offset-4 hover:underline"
        >
          Articles
        </a>
        <a
          href={`${base}search/`}
          class="inline-flex min-h-11 items-center underline-offset-4 hover:underline"
        >
          Search the site
        </a>
      </nav>
    </header>
    <main
      class="mt-6"
      data-pagefind-body={Astro.url.pathname === base ? '' : undefined}
      data-pagefind-filter="Type:Resources"
    >
      <section id="read" aria-label="Start here" class="grid scroll-mt-5 gap-3">
        {read && (
          <a
            href={read.url}
            class={`${button} bg-[#254f39] text-white hover:bg-[#1b402c]`}
          >
            <BookOpen size={24} strokeWidth={1.5} className="shrink-0" />
            <span class="min-w-0 flex-1">
              <span class="block text-base font-semibold">
                Read Quran in English
              </span>{' '}
              <span class="mt-1 block text-xs text-[#d4e4cf]">
                Free translation & audio on Quran.com
              </span>{' '}
            </span>
            <ArrowUpRight size={19} className="shrink-0" />
          </a>
        )}
        <a href={youtube} class={secondary}>
          <Play size={23} strokeWidth={1.5} className="shrink-0" />
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold">
              Watch the recordings
            </span>{' '}
            <span class="mt-1 block text-xs text-[#52695b]">
              Catch up with Ayoub on YouTube
            </span>{' '}
          </span>
          <ArrowUpRight size={18} className="shrink-0" />
        </a>
        {book && (
          <div>
            <a href={book.url} class={secondary}>
              <Book size={23} strokeWidth={1.5} className="shrink-0" />
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold">
                  The book I read on stream
                </span>{' '}
                <span class="mt-1 block text-xs text-[#52695b]">
                  The Clear Quran · English + Arabic
                </span>{' '}
              </span>
              <ArrowUpRight size={18} className="shrink-0" />
            </a>
            <p class="px-5 pt-2 text-xs leading-relaxed text-[#52695b]">
              Paid paperback. My spiral binding was done locally.
            </p>
          </div>
        )}
      </section>
      <section
        id="copies"
        aria-labelledby="copies-title"
        class="scroll-mt-5 pt-8"
      >
        <h2 id="copies-title" class="mb-3 px-1 text-sm font-semibold">
          Get a free English copy
        </h2>
        <div class="grid gap-3">
          {copies.map((link) => (
            <a href={link.url} class={secondary}>
              <PackageOpen size={23} strokeWidth={1.5} className="shrink-0" />
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold">
                  {link.icon === 'Mail'
                    ? 'Request The Clear Quran'
                    : 'Request The Quran Project'}
                </span>{' '}
                <span class="mt-1 block text-xs leading-relaxed text-[#52695b]">
                  {link.icon === 'Mail'
                    ? 'Free for non-Muslims in the USA. One copy.'
                    : 'Free for non-Muslims. Check delivery eligibility.'}
                </span>{' '}
              </span>
              <ArrowUpRight size={18} className="shrink-0" />
            </a>
          ))}
        </div>
      </section>
      <section
        id="watch"
        aria-labelledby="watch-title"
        class="scroll-mt-5 pt-8"
      >
        <h2 id="watch-title" class="mb-3 px-1 text-sm font-semibold">
          Keep learning
        </h2>
        <div class="grid gap-5">
          {videos.map((link) => {
            const thumbnail = link.youtube?.includes('PLlZaz')
              ? 'sQMC7fkjmOA'
              : link.youtube?.includes('PL9821')
                ? 'IQjzErJlpJ0'
                : link.youtube;
            return (
              <a
                href={link.url}
                class="group grid grid-cols-[7.5rem_minmax(0,1fr)] items-center gap-4 rounded-xl focus-visible:outline-offset-4 sm:grid-cols-[10rem_minmax(0,1fr)]"
              >
                <span class="relative block aspect-video overflow-hidden rounded-xl bg-secondary">
                  <img
                    src={`https://i.ytimg.com/vi/${thumbnail}/hqdefault.jpg`}
                    alt=""
                    width="480"
                    height="360"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:transform-none"
                  />
                  <span
                    class="absolute inset-0 grid place-items-center bg-black/10"
                    aria-hidden="true"
                  >
                    <span class="grid size-8 place-items-center rounded-full bg-black/70 text-white">
                      <Play size={16} fill="currentColor" />
                    </span>
                  </span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium leading-snug">
                    {link.title.replaceAll('—', '-')}
                  </span>{' '}
                  <span class="mt-2 flex items-center gap-1 text-xs font-medium text-muted-foreground">
                    {link.youtube?.startsWith('videoseries')
                      ? 'Watch playlist'
                      : 'Watch video'}{' '}
                    <ArrowUpRight size={14} aria-hidden="true" />
                  </span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
      {articles.length > 0 && (
        <section
          aria-labelledby="articles-title"
          class="pt-8"
          data-pagefind-ignore
        >
          <div class="mb-3 flex items-center justify-between">
            <h2 id="articles-title" class="text-sm font-semibold">
              Articles & understanding
            </h2>
            <a
              href={`${base}articles/`}
              class="inline-flex min-h-11 items-center gap-1 text-xs font-medium"
            >
              View all <ArrowUpRight size={14} />
            </a>
          </div>
          <div class="grid gap-4">
            {articles.slice(0, 3).map((article) => (
              <a
                href={`${base}articles/${article.id}/`}
                class="flex min-h-16 items-center gap-4 rounded-xl py-2 hover:bg-secondary"
              >
                <BookOpen size={24} className="shrink-0" />
                <span>
                  <span class="text-xs text-muted-foreground">
                    {article.data.category}
                  </span>
                  <span class="mt-1 block text-sm font-semibold">
                    {article.data.title}
                  </span>
                  <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
                    {article.data.description}
                  </span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
      <section id="more" aria-labelledby="more-title" class="scroll-mt-5 pt-7">
        <h2 id="more-title" class="mb-3 px-1 text-sm font-semibold">
          More from the live
        </h2>
        <div class="grid gap-3">
          {resources.map((link) => {
            const label = resourceLabels[link.icon];
            const Icon = label?.Icon ?? BookOpen;
            return (
              <a href={link.url} class={secondary}>
                <Icon size={22} strokeWidth={1.5} className="shrink-0" />
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium">
                    {label?.title ?? link.title}
                  </span>{' '}
                  <span class="mt-1 block text-xs text-[#52695b]">
                    {label?.description ?? link.description}
                  </span>{' '}
                </span>
                <ArrowUpRight size={17} className="shrink-0" />
              </a>
            );
          })}
        </div>
      </section>
      {support && (
        <a
          href={support.url}
          class="mt-6 flex min-h-24 items-center gap-4 rounded-3xl border-2 border-[#ff6433] bg-white p-5 transition-colors hover:bg-[#fff1eb]"
        >
          <img
            src="https://cdn.prod.website-files.com/5c14e387dab576fe667689cf/670f5a01229bf8a18f97a3c1_favion.avif"
            alt=""
            width="48"
            height="48"
            loading="lazy"
            class="size-12 shrink-0 object-contain"
          />
          <span class="min-w-0 flex-1">
            <span class="block text-base font-semibold">
              Support my work on Ko-fi
            </span>{' '}
            <span class="mt-1 block text-sm leading-relaxed text-[#52695b]">
              Help me keep sharing Islam through dawah, Quran readings, hadith
              discussions, TikTok lives, and my podcast for the ummah.
            </span>
          </span>
        </a>
      )}
    </main>
    <footer class="mt-5 text-center text-xs text-[#52695b]">
      <p>For anyone curious about the Quran.</p>
      <details class="mt-1">
        <summary class="inline-flex min-h-11 cursor-pointer items-center underline decoration-current/30 underline-offset-4">
          About & privacy
        </summary>
        <p class="mx-auto max-w-sm pb-3 leading-relaxed">
          Links shared by Ayoub during live Quran readings. Contact me through
          the profiles above. This page has no forms, accounts, or sign-ins.
          Linked services have their own privacy policies.
        </p>
      </details>
    </footer>
  </div>
</div>
