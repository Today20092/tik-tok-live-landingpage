---
import { getCollection } from 'astro:content';
import kofiCup from '../assets/kofi-cup.png';
interface Props { compact?: boolean; floating?: boolean }
const { compact = false, floating = false } = Astro.props;
const support = (await getCollection('links')).find(({ data }) => data.variant === 'support');
if (!support) throw new Error('The Ko-fi support resource is required.');
---

{compact || floating ? (
  <a href={support.data.url} class:list={['control', 'support-button', 'support-link', { 'support-floating': floating }]} data-pagefind-ignore>
    <img src={kofiCup.src} width="24" height="19" alt="" aria-hidden="true" class="support-icon" />
    <span class="support-label">{floating ? 'Support monthly' : 'Support monthly on Ko-fi'}</span> {!floating && <span aria-hidden="true">↗</span>}
  </a>
) : (
  <section class="support-card" aria-label="Support my work" data-pagefind-ignore>
    <h2 class="section-title">Help me keep sharing this work</h2>
    <p>I share Quran readings in English, conversations about Islam, and filmmaking and editing education through Alpha Bravo Media. Monthly support helps me make more time for this work alongside earning a living.</p>
    <p>$3 a month helps. If you comfortably give more, that helps too. Please only contribute what fits your circumstances. Everyone is welcome, and the readings and resources remain freely available.</p>
    <p class="support-goal">My first goal: find 10 monthly supporters.</p>
    <a href={support.data.url} class="control support-button">
      <img src={kofiCup.src} width="24" height="19" alt="" aria-hidden="true" class="support-icon" />
      <span class="support-label">Support monthly on Ko-fi</span> <span aria-hidden="true">↗</span>
    </a>
  </section>
)}

<style>
  @layer components {
    .support-icon { width: 24px; height: auto; flex: none; }
    .support-label { min-width: 0; overflow-wrap: anywhere; }
    .support-button {
      max-width: 100%;
      background: var(--support-accent);
      color: var(--support-foreground);
      border-color: var(--support-accent);
      font-weight: 600;
    }
    .support-button:hover { background: color-mix(in srgb, var(--support-accent) 90%, var(--support-foreground)); }
    .support-link { justify-self: start; white-space: normal; }
    .support-floating {
      font-size: var(--text-small);
      gap: var(--space-1);
      padding-inline: var(--space-3);
      border-radius: var(--radius-main);
    }
    .support-floating .support-icon { width: 20px; }
    .support-goal { font-weight: 600; }
    .support-card {
      margin-block: var(--space-8);
      padding: var(--space-6);
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-main);
    }
    .support-card h2 { font-size: var(--text-2xl); }
    .support-card p { margin-block: 0 var(--space-5); max-width: 65ch; }
    .support-card a { white-space: normal; }
  }
</style>
