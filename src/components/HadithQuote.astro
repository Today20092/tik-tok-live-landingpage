---
import '@fontsource/amiri-quran/arabic-400.css';
import { IconArrowUpRight, IconChevronDown } from '@tabler/icons-react';
import entries from '@/data/hadith.json';

interface Props {
  hadith: keyof typeof entries;
  showArabic?: boolean;
}

interface Hadith {
  reference: string;
  url: string;
  narrator?: string;
  arabic?: string;
  translation: string;
  translationSource: string;
  excerpt: boolean;
  grade?: { text: string; attributedTo: string; url: string };
  checkedOn: string;
}

const { hadith, showArabic = true } = Astro.props;
if (!Object.hasOwn(entries, hadith)) {
  throw new Error(
    `Hadith ${hadith} has no checked text in src/data/hadith.json.`
  );
}
const entry: Hadith = entries[hadith];
const source = new URL(entry.url);
if (source.protocol !== 'https:') {
  throw new Error(`Hadith ${hadith} needs an HTTPS source URL.`);
}
if (
  entry.grade &&
  (!entry.grade.text.trim() || !entry.grade.attributedTo.trim())
) {
  throw new Error(`Hadith ${hadith} needs both a grade and its attribution.`);
}
if (entry.grade && new URL(entry.grade.url).protocol !== 'https:') {
  throw new Error(`Hadith ${hadith} needs an HTTPS grading source.`);
}
---

<figure
  data-not-typeset
  data-hadith={hadith}
  dir="ltr"
  class="hadith-quote_figure"
>
  <blockquote cite={entry.url} class="hadith-quote_blockquote">
    {showArabic && entry.arabic && (
      <p lang="ar" dir="rtl" class="quotation_arabic">
        {entry.arabic}
      </p>
    )}
    <p lang="en" dir="ltr" class="hadith-quote_p-2">
      {entry.translation}
    </p>
  </blockquote>
  <figcaption class="hadith-quote_figcaption">
    <div class="hadith-quote_div">
      <a href={entry.url} class="group hadith-quote_a">
        <span class="hadith-quote_span">{entry.reference}</span>
        <IconArrowUpRight
          size={16}
          aria-hidden="true"
          className="flex-noshrink"
        />
      </a>
      <span data-hadith-authenticity>
        <span class="visually-hidden">Authenticity: </span>
        {entry.grade?.text ?? 'Authenticity not yet verified'}
      </span>
    </div>
    {entry.excerpt && (
      <p class="hadith-quote_p-3">Excerpt from the full hadith</p>
    )}
    <details class="group">
      <summary class="hadith-quote_summary">
        Source details
        <IconChevronDown
          size={16}
          aria-hidden="true"
          className="hadith-quote_iconchevrondown"
        />
      </summary>
      <div class="hadith-quote_div-2">
        {entry.narrator && <p class="u-m-0">Narrated by {entry.narrator}</p>}
        <p class="u-m-0">Translation: {entry.translationSource}</p>
        {entry.grade && (
          <a href={entry.grade.url} class="hadith-quote_a-2">
            <span>{entry.grade.attributedTo}</span>
            <IconArrowUpRight
              size={16}
              aria-hidden="true"
              className="flex-noshrink"
            />
          </a>
        )}
      </div>
    </details>
  </figcaption>
</figure>
