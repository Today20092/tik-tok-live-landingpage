---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  title: string;
  description?: string;
  /** Call to action, shown with an outward arrow. */
  action?: string;
}

const {
  title,
  description,
  action,
  class: className,
  href,
  ...attributes
} = Astro.props;
---

<a href={href} class:list={['resource-card', className]} {...attributes}>
  <slot name="start" />
  <span class="resource-card_content">
    <span class="resource-card_title">{title}</span>
    {description && (
      <>
        {' '}
        <span class="resource-card_description">{description}</span>
      </>
    )}
    {action && (
      <>
        {' '}
        <span class="resource-card_action">
          {action} <span aria-hidden="true">↗</span>
        </span>
      </>
    )}
    <slot />
  </span>
  <slot name="end" />
</a>
