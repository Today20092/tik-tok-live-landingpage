---
import stars from '../assets/patterns/eight-point.svg?url';
import rosettes from '../assets/patterns/rosettes.svg?url';
import sixfold from '../assets/patterns/sixfold.svg?url';
import tenfold from '../assets/patterns/tenfold.svg?url';
import twelvefold from '../assets/patterns/twelvefold.svg?url';
import octagons from '../assets/patterns/octagons.svg?url';
import lattice from '../assets/patterns/lattice.svg?url';
const patternImages = {
  stars,
  rosettes,
  sixfold,
  tenfold,
  twelvefold,
  octagons,
  lattice,
};
const palettes = [
  ['rp-dawn', 'Rosé Pine Dawn', '#faf4ed', '#907aa9'],
  ['gruvbox', 'Gruvbox Light', '#fbf1c7', '#076678'],
  ['lotus', 'Kanagawa Lotus', '#f2ecbc', '#4d699b'],
  ['nord', 'Nord', '#2e3440', '#88c0d0'],
  ['vesper', 'Vesper', '#101010', '#ffc799'],
  ['hedger', 'Hedger neutral', '#171717', '#e5e5e5'],
  ['scholarly', 'Scholarly inspired', '#fbfaf6', '#335966'],
  ['norevia', 'Norevia inspired', '#0e1315', '#6eb4c2'],
  ['ivory', 'Ivory & lapis', '#f4f0e6', '#214b78'],
  ['ceramic', 'Porcelain & turquoise', '#e8f0ed', '#155963'],
  ['limestone', 'Limestone & umber', '#eee7d9', '#52432f'],
  ['lapis', 'Lapis & parchment', '#122532', '#c9b477'],
  ['cypress', 'Cypress & ivory', '#f0eddf', '#204b3b'],
  ['aubergine', 'Aubergine & copper', '#291f28', '#e4b68d'],
  ['terracotta', 'Terracotta & cream', '#efd6c6', '#923e2f'],
  ['sand', 'Sand & teal', '#e8dbb9', '#185c59'],
  ['wine', 'Parchment & wine', '#eadbc0', '#722f48'],
  ['blue', 'Porcelain & cobalt', '#dce5ec', '#274e92'],
  ['ochre', 'Ochre & ink', '#efdfa8', '#333c56'],
  ['rose', 'Rose & espresso', '#e9d2d1', '#593d35'],
  ['lavender', 'Lavender & olive', '#e0daea', '#4d572f'],
  ['midnight', 'Midnight & brass', '#1d293e', '#dfb969'],
  ['plum', 'Plum & apricot', '#302233', '#efb888'],
  ['charcoal', 'Charcoal & coral', '#242726', '#edaa8e'],
  ['flexoki', 'Flexoki paper', '#fffcf0', '#205ea6'],
  ['mocha', 'Catppuccin mocha', '#1e1e2e', '#cba6f7'],
  ['original', 'Original', '#f7f9f5', '#254f39'],
  ['sage', 'Sage paper', '#e4e8db', '#344c36'],
  ['olive', 'Warm olive', '#e6dfcd', '#4b5031'],
  ['pine', 'Soft pine', '#cfdbd1', '#214b3b'],
  ['forest', 'Forest night', '#18251e', '#c3d3aa'],
];
---

<details
  open
  class="mb-8 rounded-lg border border-input bg-card p-4 text-card-foreground min-[1200px]:fixed min-[1200px]:top-8 min-[1200px]:left-4 min-[1200px]:max-h-[calc(100dvh-4rem)] min-[1200px]:w-64 min-[1200px]:overflow-y-auto"
  data-palette-preview
  data-pagefind-ignore
>
  <summary class="min-h-11 cursor-pointer text-sm font-semibold">
    Color & geometry preview
  </summary>
  <fieldset class="mt-2">
    <legend class="mb-2 text-xs text-muted-foreground">Choose a palette</legend>
    <div class="flex flex-wrap gap-2">
      {[palettes.slice(0, 8), palettes.slice(8, 14), palettes.slice(14)].map(
        (group, index) => (
          <details open={index === 0} class="w-full" data-palette-group>
            <summary class="min-h-11 cursor-pointer text-sm font-medium">
              {
                [
                  'From your references',
                  'Previous new directions',
                  'Earlier palettes',
                ][index]
              }
            </summary>
            <div class="flex flex-wrap gap-2">
              {group.map(([value, label, background, foreground]) => (
                <label class="relative flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-input px-3 text-sm has-[:checked]:bg-secondary has-[:checked]:outline-2 has-[:checked]:outline-ring has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-ring">
                  <input
                    type="radio"
                    name="palette"
                    value={value}
                    checked={value === 'rp-dawn'}
                    class="sr-only"
                  />
                  <span
                    aria-hidden="true"
                    class="grid size-5 place-items-center rounded-full border border-current text-xs font-bold"
                    style={{ background, color: foreground }}
                  >
                    Aa
                  </span>
                  {label}
                </label>
              ))}
            </div>
          </details>
        )
      )}
    </div>
  </fieldset>
  <fieldset class="mt-4">
    <legend class="mb-2 text-xs text-muted-foreground">Islamic geometry</legend>
    <div class="flex flex-wrap gap-2">
      {[
        'None',
        'Stars',
        'Rosettes',
        'Sixfold',
        'Tenfold',
        'Twelvefold',
        'Octagons',
        'Lattice',
      ].map((label) => (
        <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-input px-3 text-sm has-[:checked]:bg-secondary has-[:checked]:outline-2 has-[:checked]:outline-ring">
          <input
            type="radio"
            name="pattern"
            value={label.toLowerCase()}
            checked={label === 'Rosettes'}
            class="size-4 accent-foreground"
          />
          {label}
        </label>
      ))}
    </div>
  </fieldset>
  <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
    Original geometric studies informed by{' '}
    <a
      href="https://artofislamicpattern.com/resources/educational-posters/"
      class="underline underline-offset-4"
    >
      Art of Islamic Pattern
    </a>
    . The original rosette is preserved.
  </p>
  <fieldset class="mt-4">
    <legend class="mb-2 text-xs text-muted-foreground">Pattern strength</legend>
    <div class="flex flex-wrap gap-2">
      {['Soft', 'Medium', 'Bold'].map((label) => (
        <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-input px-3 text-sm has-[:checked]:bg-secondary has-[:checked]:outline-2 has-[:checked]:outline-ring">
          <input
            type="radio"
            name="strength"
            value={label.toLowerCase()}
            checked={label === 'Bold'}
            class="size-4 accent-foreground"
          />
          {label}
        </label>
      ))}
    </div>
  </fieldset>
  <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
    Published palettes and site-inspired adaptations are grouped first. Small
    text is adjusted for contrast with geometry.
    <a
      href="https://astro-palette.8limb.dev/"
      class="underline underline-offset-4"
    >
      Astro Palette
    </a>
    ,
    <a href="https://hedger.ch/posts" class="underline underline-offset-4">
      Hedger
    </a>
    ,
    <a
      href="https://astro-theme-scholars.pages.dev/"
      class="underline underline-offset-4"
    >
      Scholarly
    </a>
    ,
    <a href="https://norevia.pages.dev/" class="underline underline-offset-4">
      Norevia
    </a>
    . Development preview. Your choices stay in this browser. Collapse this
    panel to see the page.
  </p>
  <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
    New color studies use ceramic whites, mineral blues and manuscript-inspired
    ink and brass. Earlier palette references:
    <a
      href="https://stephango.com/flexoki"
      class="underline underline-offset-4"
    >
      Flexoki by Steph Ango
    </a>
    and{' '}
    <a
      href="https://github.com/catppuccin/catppuccin"
      class="underline underline-offset-4"
    >
      Catppuccin Mocha
    </a>
    . Adapted to this page with stronger secondary text where needed.
  </p>
</details>

<script is:inline define:vars={{ patternImages }}>
  (() => {
    const panel = document.querySelector('[data-palette-preview]');
    const root = document.documentElement;
    const apply = () => {
      root.dataset.palette = panel.querySelector(
        '[name="palette"]:checked'
      ).value;
      root.dataset.pattern = panel.querySelector(
        '[name="pattern"]:checked'
      ).value;
      root.style.setProperty(
        '--pattern-image',
        patternImages[root.dataset.pattern]
          ? `url("${patternImages[root.dataset.pattern]}")`
          : 'none'
      );
      root.dataset.strength = panel.querySelector(
        '[name="strength"]:checked'
      ).value;
    };
    try {
      for (const name of ['palette', 'pattern', 'strength']) {
        const saved = localStorage.getItem(`ayoub-preview-${name}`);
        const input = [...panel.querySelectorAll(`input[name="${name}"]`)].find(
          (input) => input.value === saved
        );
        if (input) {
          input.checked = true;
          input.closest('[data-palette-group]')?.setAttribute('open', '');
        }
      }
    } catch {
      /* Preview still works when browser storage is unavailable. */
    }
    apply();
    panel.addEventListener('change', () => {
      apply();
      try {
        localStorage.setItem('ayoub-preview-palette', root.dataset.palette);
        localStorage.setItem('ayoub-preview-pattern', root.dataset.pattern);
        localStorage.setItem('ayoub-preview-strength', root.dataset.strength);
      } catch {
        /* No persistence required to compare colors. */
      }
    });
  })();
</script>

