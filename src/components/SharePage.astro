---
import { IconShare, IconCopy, IconMail } from '@tabler/icons-react';
interface Props {
  title: string;
  description: string;
  url: string;
}
const { title, description, url } = Astro.props;
const button = 'control control-outline';
---

<section
  data-share-page
  data-title={title}
  data-description={description}
  data-url={url}
  data-pagefind-ignore
  class="share-page"
  aria-labelledby="share-title"
>
  <div class="share-page_content">
    <h2 id="share-title" class="share-page_share-title">
      Share this page
    </h2>
    <p class="share-page_intro">Know someone who would find this useful?</p>
    <div class="share-page_actions">
      <button type="button" data-native-share class={button}>
        <IconShare size={18} aria-hidden="true" /> Share
      </button>
      <button type="button" data-copy-link class={button}>
        <IconCopy size={18} aria-hidden="true" /> Copy link
      </button>
      <a
        href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${description}\n\n${url}`)}`}
        class={button}
      >
        <IconMail size={18} aria-hidden="true" /> Email
      </a>
    </div>
    <p data-share-status role="status" class="share-page_status"></p>
    <label data-share-fallback hidden class="share-page_label">
      Copy this address
      <input readonly value={url} class="share-page_address" />
    </label>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-share-page]')
    .forEach((section) => {
      const status = section.querySelector<HTMLElement>('[data-share-status]')!;
      const fallback = section.querySelector<HTMLElement>(
        '[data-share-fallback]'
      )!;
      const data = {
        title: section.dataset.title!,
        text: section.dataset.description!,
        url: section.dataset.url!,
      };
      const copy = async () => {
        try {
          await navigator.clipboard.writeText(data.url);
          status.textContent = 'Link copied.';
          fallback.hidden = true;
        } catch {
          status.textContent = 'Select and copy the address below.';
          fallback.hidden = false;
          fallback.querySelector('input')!.select();
        }
      };
      section
        .querySelector('[data-copy-link]')!
        .addEventListener('click', copy);
      section
        .querySelector('[data-native-share]')!
        .addEventListener('click', async () => {
          status.textContent = '';
          if (navigator.share) {
            try {
              await navigator.share(data);
              return;
            } catch (error) {
              if (error instanceof DOMException && error.name === 'AbortError')
                return;
            }
          }
          await copy();
        });
    });
</script>
